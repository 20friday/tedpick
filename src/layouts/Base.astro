---
import SiteFooter from '../components/SiteFooter.astro';
import SiteFooterMin from '../components/SiteFooterMin.astro';

interface Props {
  title?: string;
  description?: string;
  footer?: 'default' | 'minimal' | 'none';
  header?: 'default' | 'none';
  sectionNav?: boolean;
}
const { title = '테드픽', description = '매일 12시, 장 정리', footer = 'default', header = 'default', sectionNav = true } = Astro.props;
const { user } = Astro.locals;
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} — 테드픽</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/png" href="/favicon.png" />

  <!-- ── Google Analytics 4 (쿠키 없는 방식) ── -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-XY9KNNSY9W"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){ dataLayer.push(arguments); }
    gtag('js', new Date());
    gtag('config', 'G-XY9KNNSY9W', {
      anonymize_ip: true,
      client_storage: 'none'
    });
  </script>
</head>
<body>
  <div class="app">
    {header !== 'none' && <header class:list={['hdr', { 'hdr--bare': !sectionNav }]}>
      <div class="hdr-inner">
        <a href="/" class="brand">
          <img src="/ted_logo.svg" alt="테드픽" class="brand-logo" />
        </a>
        <div class="hdr-spacer"></div>
        <a href="/search" class="hdr-search-btn" aria-label="종목 검색">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
            <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.9"/>
            <path d="m20 20-3.4-3.4" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/>
          </svg>
        </a>
        {user ? (
          <a href="/mypage" class="hamburger-btn" aria-label="메뉴">
            <span></span>
            <span></span>
            <span></span>
          </a>
        ) : (
          <a href="/login" class="btn-pill ghost">로그인</a>
        )}
      </div>
      {sectionNav && <nav class="hdr-tabs" style="border-top: none;">
        <a href="/" class:list={['hdr-tab', { active: Astro.url.pathname === '/' }]}>홈</a>
        <a href="/feed" class:list={['hdr-tab', { active: Astro.url.pathname.startsWith('/feed') }]}>방송 요약</a>
        <a href="/stock" class:list={['hdr-tab', { active: Astro.url.pathname.startsWith('/stock') }]}>종목 랭킹</a>
        <a href="/lab" class:list={['hdr-tab', { active: Astro.url.pathname.startsWith('/lab') }]}>실험실</a>
      </nav>}
    </header>}
    <main>
      <slot />
    </main>
    {footer === 'default' && <SiteFooter />}
    {footer === 'minimal' && <SiteFooterMin />}

  </div>

  <!-- ── 공통 종목 팝업 ── -->
  <div id="sp-backdrop" class="sp-backdrop"></div>
  <div id="sp-sheet" class="sp-sheet" aria-hidden="true" role="dialog">
    <div class="sp-inner">
      <div id="sp-content" class="sp-content"></div>
      <button id="sp-close" class="sp-close">닫기</button>
    </div>
  </div>

</body>
</html>

<style is:global>
  @import '../styles/global.css';

  /* ── 종목명 밑줄 태그 ── */
  .stock-tag {
    border-bottom: 1px solid #94a0ad;
    cursor: pointer;
    display: inline;
  }
  .stock-tag:hover {
    border-bottom-color: var(--text-1);
  }

  /* ── 공통 종목 팝업 ── */
  .sp-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.45);
    z-index: 900;
  }
  .sp-backdrop.open { display: block; }

  .sp-sheet {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 901;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }
  .sp-sheet.open { display: flex; }

  .sp-inner {
    background: var(--card, #fff);
    border-radius: 20px;
    width: 100%;
    max-width: 480px;
    max-height: 80vh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    animation: sp-in 220ms cubic-bezier(0.32,0.72,0,1);
  }
  @keyframes sp-in {
    from { transform: scale(0.95); opacity: 0; }
    to   { transform: scale(1); opacity: 1; }
  }

  .sp-content {
    flex: 1;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    padding: 20px 20px 8px;
  }
  .sp-stock-name {
    font-size: 22px;
    font-weight: 800;
    color: var(--text-1);
    margin-bottom: 6px;
  }
  .sp-stock-header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 24px;
  }
  .sp-stock-count {
    font-size: 15px;
    color: var(--text-3);
  }
  .sp-date-group {
    margin-bottom: 24px;
  }
  .sp-date-label {
    font-size: 14px;
    font-weight: 700;
    color: var(--accent, #e86c2c);
    margin-bottom: 12px;
  }
  .sp-mention {
    padding: 12px 0;
    border-bottom: 1px solid var(--divider);
  }
  .sp-mention:last-child { border-bottom: none; }
  .sp-mention-show {
    font-size: 15px;
    font-weight: 700;
    color: var(--text-1);
    margin-bottom: 6px;
  }
  .sp-mention-view {
    font-size: 16px;
    color: var(--text-1);
    line-height: 1.6;
  }
  .sp-history-btn {
    font-size: 14px;
    font-weight: 700;
    color: var(--accent, #e86c2c);
    text-decoration: none;
    white-space: nowrap;
  }
  .sp-empty {
    font-size: 16px;
    color: var(--text-3);
    padding: 20px 0;
  }
  .sp-loading {
    font-size: 16px;
    color: var(--text-3);
    padding: 32px 0;
    text-align: center;
  }
  .sp-close {
    display: block;
    flex-shrink: 0;
    width: calc(100% - 40px);
    margin: 8px 20px 20px;
    padding: 16px;
    border-radius: 14px;
    background: var(--border, #e8eaed);
    border: none;
    font-size: 16px;
    font-weight: 700;
    color: var(--text-2);
    cursor: pointer;
    font-family: var(--font);
  }
  .sp-close:active { background: var(--divider); }
</style>

<script>
  const backdrop = document.getElementById('sp-backdrop')!;
  const sheet    = document.getElementById('sp-sheet')!;
  const content  = document.getElementById('sp-content')!;

  function formatDate(dateStr: string) {
    const d = new Date(dateStr + 'T00:00:00+09:00');
    return `${d.getMonth() + 1}월 ${d.getDate()}일 (${['일','월','화','수','목','금','토'][d.getDay()]})`;
  }

  window.openStockPopup = async function(name: string) {
    // 열기
    content.innerHTML = `<div class="sp-stock-name">${name}</div><div class="sp-loading">불러오는 중…</div>`;
    backdrop.classList.add('open');
    sheet.classList.add('open');
    sheet.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';

    try {
      const res = await fetch(`/api/stock-popup?name=${encodeURIComponent(name)}`);
      const { mentions } = await res.json();

      // 날짜별 그룹핑
      const groups: Record<string, typeof mentions> = {};
      for (const m of (mentions ?? [])) {
        (groups[m.date] ??= []).push(m);
      }
      const dates = Object.keys(groups).sort((a, b) => b.localeCompare(a));

      let html = `<div class="sp-stock-name">${name}</div>`;
      html += `<div class="sp-stock-header-row">`;
      html += `<span class="sp-stock-count">${mentions?.length ? `최근 ${mentions.length}건 언급` : '최근 언급 없음'}</span>`;
      html += `<a class="sp-history-btn" href="/stock/${encodeURIComponent(name)}">히스토리 전체 보기 →</a>`;
      html += `</div>`;

      if (dates.length === 0) {
        html += `<div class="sp-empty">최근 30일 언급 기록이 없어요.</div>`;
      } else {
        for (const date of dates) {
          html += `<div class="sp-date-group">`;
          html += `<div class="sp-date-label">${formatDate(date)}</div>`;
          for (const m of groups[date]) {
            html += `<div class="sp-mention">`;
            if (m.show) html += `<div class="sp-mention-show">${m.show}</div>`;
            if (m.view) html += `<div class="sp-mention-view">${m.view}</div>`;
            html += `</div>`;
          }
          html += `</div>`;
        }
      }
      content.innerHTML = html;
    } catch {
      content.innerHTML = `<div class="sp-stock-name">${name}</div><div class="sp-empty">내용을 불러올 수 없어요.</div>`;
    }
  };

  function closePopup() {
    backdrop.classList.remove('open');
    sheet.classList.remove('open');
    sheet.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  backdrop.addEventListener('click', closePopup);
  document.getElementById('sp-close')!.addEventListener('click', closePopup);
</script>

<style>
  /* ── 헤더 탭 ── */
  .hdr-tabs {
    display: flex;
    max-width: 680px;
    margin: 0 auto;
    padding: 0 8px;
    gap: 0;
  }
  .hdr-tab {
    padding: 10px 13px 9px;
    font-size: 15px;
    font-weight: 700;
    color: var(--text-3);
    text-decoration: none;
    border-bottom: 2px solid transparent;
    transition: color 160ms ease, border-color 160ms ease;
    letter-spacing: -0.01em;
  }
  .hdr-tab:hover { color: var(--text-2); }
  .hdr-tab.active {
    color: var(--text-1);
    border-bottom-color: var(--text-1);
    font-weight: 800;
  }

  /* ── 헤더 검색 버튼 ── */
  .hdr-search-btn {
    display: inline-flex; align-items: center; justify-content: center;
    width: 38px; height: 38px; margin-right: 2px;
    border-radius: 10px; color: var(--text-2);
    text-decoration: none;
    transition: background 140ms ease, color 140ms ease;
  }
  .hdr-search-btn:hover { background: var(--border); color: var(--text-1); }

  /* ── 햄버거 버튼 ── */
  .hamburger-btn {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 36px;
    height: 36px;
    background: transparent;
    padding: 4px;
    border-radius: 8px;
    transition: background 140ms;
    text-decoration: none;
  }
  .hamburger-btn:hover { background: var(--divider); }
  .hamburger-btn span {
    display: block;
    width: 20px;
    height: 2px;
    background: var(--text-1);
    border-radius: 2px;
  }
</style>
