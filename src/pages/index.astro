---
import Base from '../layouts/Base.astro';
import PrepCard from '../components/PrepCard.astro';
import { isKoreanMarketHoliday } from '../lib/marketHoliday';
import { stockInfo } from '../lib/stockInfo';

// 검색 미리보기용 종목명 → 별칭 맵 (검색 페이지와 동일)
const stockAliasMap = JSON.stringify(
  Object.fromEntries(
    stockInfo.filter(s => s.aliases?.length).map(s => [s.name, s.aliases])
  )
);

// 오늘 (KST)
const todayKey = new Date(Date.now() + 9 * 60 * 60 * 1000).toISOString().slice(0, 10);
const days = ['일', '월', '화', '수', '목', '금', '토'];
function formatDateShort(dateStr: string) {
  const d = new Date(dateStr + 'T00:00:00');
  return `${d.getMonth() + 1}월 ${d.getDate()}일 (${days[d.getDay()]})`;
}
function formatMonthDay(dateStr: string) {
  const d = new Date(dateStr + 'T00:00:00');
  return `${d.getMonth() + 1}월 ${d.getDate()}일`;
}
const todayDateLabel = formatDateShort(todayKey);
const isMarketHoliday = isKoreanMarketHoliday(todayKey);

// ── 오늘의 픽 한눈에 (시장 흐름 + 일일 리포트) ──
const { data: flowRows } = await Astro.locals.supabase
  .from('market_flow')
  .select('date, tone, headline, sectors')
  .eq('date', todayKey).limit(1);
const todayFlow: any = flowRows?.[0] ?? null;

const { data: repRows } = await Astro.locals.supabase
  .from('daily_reports')
  .select('date, headline')
  .eq('published', true).eq('date', todayKey).limit(1);
const todayReport: any = repRows?.[0] ?? null;

// PrepCard용 최신 글 slug
const { data: latestPosts } = await Astro.locals.supabase
  .from('posts').select('slug')
  .eq('published', true)
  .order('date', { ascending: false })
  .order('display_order', { ascending: true })
  .order('created_at', { ascending: false }).limit(1);
const latestSlug = latestPosts?.[0]?.slug;
const hasTodayPick = !!(todayFlow || todayReport);

// ── 내일 시장 예측 (최신 1건) + 누적 승률 ──
const { data: predRows } = await Astro.locals.supabase
  .from('market_predictions').select('*')
  .order('target_date', { ascending: false });
const preds: any[] = predRows ?? [];
const latestPred: any = preds[0] ?? null;
const scoredPreds = preds.filter((p: any) => p.scored_at);
let predHit = 0, predTotal = 0;
for (const p of scoredPreds) {
  for (const h of [p.kospi_hit, p.kosdaq_hit]) { if (h === true || h === false) { predTotal++; if (h) predHit++; } }
}
const predWinRate: number | null = predTotal ? Math.round((predHit / predTotal) * 100) : null;
const scoredAsc = [...scoredPreds].reverse();
const kospiDots: boolean[] = scoredAsc.map((p: any) => p.kospi_hit).filter((h: any) => h === true || h === false).slice(-8);
const kosdaqDots: boolean[] = scoredAsc.map((p: any) => p.kosdaq_hit).filter((h: any) => h === true || h === false).slice(-8);
const showPred = latestPred && latestPred.target_date >= todayKey;

// ── 섹터 돋보기 (상위 3개) ──
const { data: spotRows } = await Astro.locals.supabase
  .from('sector_spotlight').select('*')
  .order('rank', { ascending: true }).limit(3);
const spotlights: any[] = spotRows ?? [];

// 섹터 돋보기 표시용 매핑
const HEAT: Record<string, { label: string; cls: string }> = {
  hot: { label: '🔥 가장 뜨는 섹터', cls: 'heat-hot' },
  rising: { label: '새로 주목', cls: 'heat-mute' },
  steady: { label: '꾸준히 관심', cls: 'heat-mute' },
};
const TREND: Record<string, { label: string; cls: string }> = {
  alive: { label: '추세 살아있음', cls: 'trend-alive' },
  fading: { label: '기세 꺾이는 중', cls: 'trend-fading' },
  pop: { label: '반짝 반등 주의', cls: 'trend-pop' },
};
const INDUSTRY: Record<string, { label: string; cls: string }> = {
  growth: { label: '구조적 성장', cls: 'ind-growth' },
  mature: { label: '성숙·역풍', cls: 'ind-mute' },
  decline: { label: '사양·쇠퇴', cls: 'ind-decline' },
  turnaround: { label: '턴어라운드', cls: 'ind-turn' },
};
function dirArrow(d: string) { return d === 'up' ? '↑' : d === 'down' ? '↓' : '→'; }
---

<Base title="홈">
  <div class="home-wrap">

    <!-- ⓪ 소개 + 검색 -->
    <section class="home-hero">
      <h1 class="hero-title">경제 방송, 3분이면 충분해요</h1>
      <p class="hero-desc">매일 4개 경제 방송을 정리해 시장 흐름과 주목받는 종목을 한눈에 보여드려요.</p>
      <div class="hero-search-wrap" data-aliases={stockAliasMap}>
      <form class="hero-search" action="/search" method="get" role="search">
        <svg class="hero-search-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.9"/>
          <path d="m20 20-3.4-3.4" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/>
        </svg>
        <input class="hero-search-input" id="hero-search-input" type="search" name="q"
          placeholder="궁금한 종목을 검색해 보세요"
          autocomplete="off" autocapitalize="off" spellcheck="false" aria-label="종목 검색" />
      </form>
      <!-- 검색창 활성화 시 펼침: 입력 전엔 최근 검색, 입력하면 종목 미리보기 -->
      <div class="hero-drop" id="hero-drop" hidden>
        <div id="hero-recent-sec">
          <div class="hero-recent-head">
            <span class="hero-recent-title">최근 검색</span>
            <button type="button" class="hero-recent-clear" id="hero-recent-clear">전체 삭제</button>
          </div>
          <div class="hero-recent-list" id="hero-recent-list"></div>
        </div>
        <div id="hero-suggest" hidden></div>
      </div>
      </div>
    </section>

    <!-- 오늘 칩 + 날짜 -->
    <div class="today-chip-row">
      <span class="today-chip"><span class="today-dot"></span>오늘</span>
      <span class="today-date-text">{todayDateLabel}</span>
    </div>

    <!-- ① 오늘의 픽 한눈에 -->
    {hasTodayPick ? (
      <a
        class={`pick-card pick-card--daily${todayReport ? '' : ' pick-card--nolink'}`}
        href={todayReport ? `/report/${todayKey}` : undefined}
      >
        <div class="pick-label pick-label--summary">⚡ 오늘의 요약</div>
        <div class="pick-headline">{todayFlow?.headline ?? todayReport?.headline}</div>
        {Array.isArray(todayFlow?.sectors) && todayFlow.sectors.length > 0 && (
          <div class="summary-sectors">
            {todayFlow.sectors.slice(0, 4).map((s: any) => (
              <span class={`summary-sec summary-sec--${s.dir ?? 'neutral'}`}>
                <span class="summary-arrow">{s.dir === 'up' ? '↑' : s.dir === 'down' ? '↓' : '→'}</span>
                {s.name}{s.label ? ` · ${s.label}` : ''}
              </span>
            ))}
          </div>
        )}
        {todayReport && <div class="pick-cta">3분 요약 →</div>}
      </a>
    ) : (
      <PrepCard latestSlug={latestSlug} isMarketHoliday={isMarketHoliday} todayLabel={todayDateLabel} />
    )}

    <!-- ② 내일 시장 예측 -->
    {showPred && (
      <div class="home-block">
        <div class="mpred">
          <div class="mpred-top">
            <span class="mpred-eyebrow">🔮 {formatMonthDay(latestPred.target_date)} 시장 예측</span>
            <span class="mpred-base">{formatDateShort(latestPred.base_date)} 방송 기준</span>
          </div>
          <div class="mpred-tiles">
            <div class="mpred-tile">
              <span class="mpred-wx">{latestPred.kospi_dir === 'up' ? '☀️' : '🌧️'}</span>
              <div>
                <div class="mpred-idx">코스피</div>
                <div class={`mpred-dir mpred-dir--${latestPred.kospi_dir}`}>
                  {latestPred.kospi_dir === 'up' ? '상승 예상 ↗' : '하락 예상 ↘'}
                </div>
              </div>
            </div>
            <div class="mpred-tile">
              <span class="mpred-wx">{latestPred.kosdaq_dir === 'up' ? '☀️' : '🌧️'}</span>
              <div>
                <div class="mpred-idx">코스닥</div>
                <div class={`mpred-dir mpred-dir--${latestPred.kosdaq_dir}`}>
                  {latestPred.kosdaq_dir === 'up' ? '상승 예상 ↗' : '하락 예상 ↘'}
                </div>
              </div>
            </div>
          </div>
          {latestPred.reason && <p class="mpred-reason">{latestPred.reason}</p>}
          {predWinRate !== null && (
            <div class="mpred-record">
              <div class="mpred-rate-row">
                <div class="mpred-rate-label">지금까지 적중률</div>
                <div class="mpred-gauge"><div class="mpred-gauge-fill" style={`width:${predWinRate}%`}></div></div>
                <div class="mpred-rate-num">{predWinRate}<span>%</span></div>
              </div>
              <div class="mpred-dots-row">
                <span class="mpred-dots-label">코스피</span>
                {kospiDots.map((h: boolean) => <span class={`mpred-mark ${h ? 'hit' : 'miss'}`}>{h ? 'O' : 'X'}</span>)}
              </div>
              <div class="mpred-dots-row">
                <span class="mpred-dots-label">코스닥</span>
                {kosdaqDots.map((h: boolean) => <span class={`mpred-mark ${h ? 'hit' : 'miss'}`}>{h ? 'O' : 'X'}</span>)}
              </div>
            </div>
          )}
          <div class="mpred-disc">AI가 방송을 분석한 재미 예측이에요. 투자 판단은 스스로 해요.</div>
        </div>
      </div>
    )}

    <!-- ③ 섹터 돋보기 -->
    {spotlights.length > 0 && (
      <div class="home-block">
        <div class="home-sec-label spot-label">🔎 섹터 돋보기</div>
        <p class="spot-desc">지금 방송에서 주목받는 섹터를, 주가와 업황을 나눠 보고 길게 투자할 가치가 있는지까지 정리했어요.</p>
        {spotlights.map((s: any) => {
          const heat = HEAT[s.heat] ?? HEAT.rising;
          const trend = TREND[s.trend_state] ?? TREND.alive;
          const industry = INDUSTRY[s.industry_type] ?? INDUSTRY.mature;
          return (
            <div class="spot-card">
              <div class="spot-head">
                <div class="spot-head-left">
                  <span class="spot-name">{s.name}</span>
                  <span class={`spot-heat ${heat.cls}`}>{heat.label}</span>
                </div>
                <span class={`spot-trend ${trend.cls}`}>{trend.label}</span>
              </div>

              <div class="spot-metrics">
                <div class="spot-metric">
                  <div class="spot-metric-k">주가</div>
                  <div class={`spot-metric-v dir-${s.price_dir}`}>{s.price_label || '-'} {dirArrow(s.price_dir)}</div>
                </div>
                <div class="spot-metric">
                  <div class="spot-metric-k">업황</div>
                  <div class={`spot-metric-v dir-${s.biz_dir}`}>{s.biz_label || '-'} {dirArrow(s.biz_dir)}</div>
                </div>
                <div class="spot-metric">
                  <div class="spot-metric-k">산업 성격</div>
                  <div class={`spot-metric-v ${industry.cls}`}>{industry.label}</div>
                </div>
              </div>

              <p class="spot-body">{s.body}</p>

              {s.caution && (
                <div class="spot-caution">
                  <span class="spot-caution-ic">⚠️</span>
                  <span class="spot-caution-tx">{s.caution}</span>
                </div>
              )}

              <a class="spot-ev" href={s.evidence_href || '/feed'}>
                <span class="spot-ev-note">{s.evidence_note || '방송 근거 살펴보기'}</span>
                <span class="spot-ev-cta">방송 근거 보기 →</span>
              </a>
            </div>
          );
        })}
      </div>
    )}

  </div>
</Base>

<script>
  // 홈 검색창 펼침 — 입력 전엔 최근 검색어, 입력하면 종목 미리보기.
  // 최근 검색어 저장소·종목 매칭 규칙은 검색 페이지(search.astro)와 같다.
  type Recent = { name: string; ts: number };
  type Stock = { name: string; market: string; aliases: string[]; mentions: number };

  const RECENT_KEY = 'tedpick_recent_searches';
  const MAX_CHIPS = 8;
  const MAX_SUGGEST = 6;
  const MARKET_LABEL: Record<string, string> = { KP: '코스피', KQ: '코스닥' };

  const wrap = document.querySelector<HTMLElement>('.hero-search-wrap');
  const drop = document.getElementById('hero-drop');
  const recentSec = document.getElementById('hero-recent-sec');
  const list = document.getElementById('hero-recent-list');
  const suggest = document.getElementById('hero-suggest');
  const clearAll = document.getElementById('hero-recent-clear');
  const input = document.getElementById('hero-search-input') as HTMLInputElement | null;
  const isTouch = window.matchMedia('(hover: none) and (pointer: coarse)').matches;

  function loadRecent(): Recent[] {
    try {
      const a = JSON.parse(localStorage.getItem(RECENT_KEY) || '[]');
      return Array.isArray(a) ? a : [];
    } catch { return []; }
  }
  function saveRecent(a: Recent[]) {
    try { localStorage.setItem(RECENT_KEY, JSON.stringify(a)); } catch {}
  }
  function addRecent(name: string) {
    const a = [{ name, ts: Date.now() }, ...loadRecent().filter((x) => x.name !== name)].slice(0, 20);
    saveRecent(a);
  }

  // 종목 목록은 검색창을 처음 눌렀을 때 한 번만 불러온다.
  // 종목 목록(정적 파일)은 바로 오고, 방송 언급 횟수(API)는 늦게 와서 도착하면 채워 넣는다.
  let INDEX: Stock[] | null = null;
  let loading = false;
  function loadIndex() {
    if (loading) return;
    loading = true;
    const aliases: Record<string, string[]> = JSON.parse(wrap?.dataset.aliases || '{}');
    const metaReq = fetch('/api/stock-search-meta').then((r) => r.json()).catch(() => ({}));
    fetch('/stocks.json').then((r) => r.json()).then((all) => {
      INDEX = (all || []).map((s: any) => ({
        name: s.n,
        market: MARKET_LABEL[s.m] || '',
        aliases: aliases[s.n] || [],
        mentions: 0,
      }));
      render();
      return metaReq.then((meta) => {
        for (const s of INDEX!) s.mentions = meta?.[s.name]?.m || 0;
        render();
      });
    }).catch(() => { loading = false; });
  }

  // 이름(또는 별칭)이 검색어로 시작하면 우선, 그다음 방송 언급 많은 순
  function matches(q: string): Stock[] {
    const nq = q.trim().toLowerCase();
    if (!nq || !INDEX) return [];
    const scored: { s: Stock; hit: number }[] = [];
    for (const s of INDEX) {
      let hit = -1;
      for (const t of [s.name, ...s.aliases].map((x) => x.toLowerCase())) {
        const at = t.indexOf(nq);
        if (at === 0) { hit = 0; break; }
        if (at > 0 && hit < 0) hit = 1;
      }
      if (hit >= 0) scored.push({ s, hit });
    }
    scored.sort((a, b) => a.hit - b.hit || b.s.mentions - a.s.mentions);
    return scored.map((x) => x.s);
  }

  function nameWithMark(name: string, q: string) {
    const frag = document.createDocumentFragment();
    const at = name.toLowerCase().indexOf(q.toLowerCase());
    if (at < 0) { frag.append(name); return frag; }
    const mark = document.createElement('mark');
    mark.textContent = name.slice(at, at + q.length);
    frag.append(name.slice(0, at), mark, name.slice(at + q.length));
    return frag;
  }

  function renderRecent(): boolean {
    if (!list) return false;
    const recent = loadRecent().slice(0, MAX_CHIPS);
    list.replaceChildren(...recent.map((r) => {
      const chip = document.createElement('span');
      chip.className = 'hero-chip';
      const go = document.createElement('a');
      go.className = 'hero-chip-go';
      go.href = '/stock/' + encodeURIComponent(r.name);
      go.textContent = r.name;
      const del = document.createElement('button');
      del.type = 'button';
      del.className = 'hero-chip-del';
      del.setAttribute('aria-label', r.name + ' 삭제');
      del.innerHTML = '<svg width="10" height="10" viewBox="0 0 12 12" fill="none"><path d="M2 2l8 8M10 2l-8 8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>';
      del.addEventListener('click', () => {
        saveRecent(loadRecent().filter((x) => x.name !== r.name));
        render();
      });
      chip.append(go, del);
      return chip;
    }));
    return recent.length > 0;
  }

  function renderSuggest(q: string) {
    if (!suggest) return;
    if (!INDEX) {
      suggest.innerHTML = '<div class="hero-sg-msg">종목을 불러오는 중…</div>';
      return;
    }
    const found = matches(q);
    if (found.length === 0) {
      const msg = document.createElement('div');
      msg.className = 'hero-sg-msg';
      msg.textContent = `‘${q.trim()}’와 일치하는 종목이 없어요`;
      suggest.replaceChildren(msg);
      return;
    }
    const rows = found.slice(0, MAX_SUGGEST).map((s) => {
      const a = document.createElement('a');
      a.className = 'hero-sg-item';
      a.href = '/stock/' + encodeURIComponent(s.name);
      a.addEventListener('click', () => addRecent(s.name));
      const name = document.createElement('span');
      name.className = 'hero-sg-name';
      name.append(nameWithMark(s.name, q.trim()));
      const meta = document.createElement('span');
      meta.className = 'hero-sg-meta';
      meta.textContent = [s.market, s.mentions ? `방송 언급 ${s.mentions}회` : ''].filter(Boolean).join(' · ');
      a.append(name, meta);
      return a;
    });
    const more = document.createElement('a');
    more.className = 'hero-sg-more';
    more.href = '/search?q=' + encodeURIComponent(q.trim());
    more.textContent = `검색 결과 ${found.length}개 모두 보기 →`;
    suggest.replaceChildren(...rows, more);
  }

  function render() {
    if (!drop || !recentSec || !suggest || !input) return;
    const focused = !isTouch && document.activeElement === input;
    const q = input.value.trim();
    if (q) {
      recentSec.hidden = true;
      suggest.hidden = false;
      renderSuggest(q);
      drop.hidden = !focused;
    } else {
      suggest.hidden = true;
      const hasRecent = renderRecent();
      recentSec.hidden = !hasRecent;
      drop.hidden = !focused || !hasRecent;
    }
  }

  // 휴대폰(터치 화면)에선 네이버 앱처럼 검색창을 누르면 검색 페이지로 부드럽게 넘어간다.
  // PC에선 지금처럼 홈에서 바로 최근 검색·종목 미리보기를 펼친다.
  if (isTouch && input) {
    input.readOnly = true;  // 홈에서 키보드가 잠깐 떴다 사라지는 걸 막음
    input.addEventListener('click', () => { location.href = '/search'; });
  }

  clearAll?.addEventListener('click', () => { saveRecent([]); render(); });
  // 목록을 누를 때 검색창 포커스가 빠지지 않게 해서, 클릭 전에 목록이 닫히는 걸 막는다.
  drop?.addEventListener('mousedown', (e) => e.preventDefault());
  input?.addEventListener('focus', () => { if (!isTouch) loadIndex(); render(); });
  input?.addEventListener('blur', render);
  input?.addEventListener('input', () => { if (!isTouch) loadIndex(); render(); });
  render();
  // 뒤로가기로 돌아왔을 때(페이지 캐시) 최신 기록으로 다시 그림
  window.addEventListener('pageshow', render);
</script>

<style is:global>
  /* 홈 ↔ 검색 페이지 부드러운 전환 (지원 브라우저에서만, 동작 줄이기 설정 존중) */
  @media (prefers-reduced-motion: no-preference) {
    @view-transition { navigation: auto; }
  }
  ::view-transition-group(tp-search-bar) {
    animation-duration: 340ms;
    animation-timing-function: cubic-bezier(0.2, 0.8, 0.2, 1);
  }
</style>

<style>
  .home-wrap {
    max-width: 680px;
    margin: 0 auto;
    padding: 22px 16px 80px;
  }
  .home-block { margin-top: 28px; }

  /* ── 소개 + 검색 ── */
  .home-hero { padding: 18px 2px 30px; }
  .hero-title {
    font-size: 26px; font-weight: 800; color: var(--text-1);
    letter-spacing: -0.03em; line-height: 1.3;
  }
  .hero-desc {
    font-size: 15px; color: var(--text-2); line-height: 1.55;
    margin-top: 8px;
  }
  .hero-search {
    view-transition-name: tp-search-bar;
