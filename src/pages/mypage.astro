---
import Base from '../layouts/Base.astro';

if (!Astro.locals.session) {
  return Astro.redirect('/login');
}

const user = Astro.locals.user!;

const { data: profile } = await Astro.locals.supabase
  .from('profiles')
  .select('role, expires_at')
  .eq('user_id', user.id)
  .single();

const email = user.email ?? '';
const initial = email.charAt(0).toUpperCase();

const role = profile?.role ?? 'free';
const expiresAt = profile?.expires_at ? new Date(profile.expires_at) : null;
const now = new Date();
const isExpired = expiresAt ? expiresAt < now : true;

type BadgeMeta = { label: string; color: string; bg: string };
function roleMeta(r: string): BadgeMeta {
  if (r === 'paid')                  return { label: '구독 중',     color: '#ed781f', bg: '#fdf0e6' };
  if (r === 'trial' && !isExpired)   return { label: '무료 체험 중', color: '#3b82f6', bg: '#eff6ff' };
  if (r === 'trial' && isExpired)    return { label: '체험 만료',   color: '#8b95a1', bg: '#f2f4f6' };
  return                                    { label: '무료',         color: '#8b95a1', bg: '#f2f4f6' };
}
const badge = roleMeta(role);

const days = ['일', '월', '화', '수', '목', '금', '토'];
function formatExpiry(d: Date) {
  return `${d.getFullYear()}년 ${d.getMonth() + 1}월 ${d.getDate()}일 (${days[d.getDay()]})`;
}
function daysLeft(d: Date) {
  return Math.max(0, Math.ceil((d.getTime() - now.getTime()) / 86400000));
}
---
<Base title="내 계정">
  <div class="mypage-wrap">

    <!-- 프로필 카드 -->
    <div class="profile-card">
      <div class="avatar">{initial}</div>
      <p class="profile-email">{email}</p>
      <span class="badge" style={`color:${badge.color}; background:${badge.bg}`}>{badge.label}</span>
    </div>

    <!-- 정보 카드 -->
    <div class="info-card">

      <div class="row">
        <span class="row-label">구독 상태</span>
        <span class="row-value" style={`color:${badge.color}`}>{badge.label}</span>
      </div>

      {role === 'trial' && !isExpired && expiresAt && (
        <>
          <div class="row">
            <span class="row-label">체험 만료일</span>
            <span class="row-value">{formatExpiry(expiresAt)}</span>
          </div>
          <div class="row">
            <span class="row-label">남은 기간</span>
            <span class="row-value">{daysLeft(expiresAt)}일</span>
          </div>
        </>
      )}

      <div class="row">
        <span class="row-label">이메일</span>
        <span class="row-value" style="font-weight:400; color:var(--text-3); font-size:15px">{email}</span>
      </div>

    </div>

    <!-- 로그아웃 -->
    <form method="POST" action="/api/auth/logout">
      <button type="submit" class="logout-btn">로그아웃</button>
    </form>

  </div>
</Base>

<style>
  .mypage-wrap {
    max-width: 480px;
    margin: 0 auto;
    padding: 20px 16px 80px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  /* ── 프로필 카드 ── */
  .profile-card {
    background: var(--card);
    box-shadow: var(--shadow-card);
    border-radius: 20px;
    padding: 36px 20px 28px;
    text-align: center;
  }

  .avatar {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: #ed781f;
    color: #fff;
    font-size: 26px;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 16px;
  }

  .profile-email {
    font-size: 15px;
    color: var(--text-3);
    margin-bottom: 12px;
  }

  .badge {
    display: inline-block;
    font-size: 13px;
    font-weight: 700;
    padding: 5px 14px;
    border-radius: 20px;
    letter-spacing: -0.01em;
  }

  /* ── 정보 카드 ── */
  .info-card {
    background: var(--card);
    box-shadow: var(--shadow-card);
    border-radius: 20px;
    padding: 0 20px;
  }

  .row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 18px 0;
    border-bottom: 1px solid var(--border);
  }
  .row:last-child { border-bottom: none; }

  .row-label {
    font-size: 17px;
    color: var(--text-1);
    flex-shrink: 0;
  }

  .row-value {
    font-size: 17px;
    font-weight: 600;
    color: var(--text-1);
    text-align: right;
  }
  .row-value--muted {
    font-weight: 400;
    color: var(--text-3);
    font-size: 15px;
  }

  /* ── 로그아웃 ── */
  .logout-btn {
    width: 100%;
    padding: 18px;
    border-radius: 20px;
    background: var(--card);
    box-shadow: var(--shadow-card);
    font-size: 17px;
    font-weight: 600;
    color: var(--text-3);
    cursor: pointer;
    font-family: var(--font);
    transition: background 140ms;
  }
  .logout-btn:active { background: var(--divider); }
</style>
