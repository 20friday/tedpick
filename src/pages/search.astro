---
import Base from '../layouts/Base.astro';
import { stockInfo } from '../lib/stockInfo';

// 종목명 → aliases 맵 (검색 시 별칭 매핑용)
const stockAliasMap = JSON.stringify(
  Object.fromEntries(
    stockInfo.filter(s => s.aliases?.length).map(s => [s.name, s.aliases])
  )
);
---

<Base title="종목 검색" footer="none" header="none">
  <header class="search-hdr">
    <div class="search-hdr-inner">
      <div class="search-bar">
        <svg class="search-bar-icon" width="20" height="20" viewBox="0 0 24 24" fill="none">
          <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.9"/>
          <path d="m20 20-3.4-3.4" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/>
        </svg>
        <input id="search-input" class="search-input" type="text"
          placeholder="종목명 검색"
          autocomplete="off" autocapitalize="off" spellcheck="false" />
        <button id="search-clear" class="search-clear" hidden aria-label="지우기">
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
            <path d="M2 2l8 8M10 2l-8 8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </button>
      </div>
      <a href="#" id="search-cancel" class="search-cancel">취소</a>
    </div>
  </header>

  <main>
    <div class="feed-wrap">
      <div id="search-body">
        <div class="search-loading">불러오는 중...</div>
      </div>
    </div>
  </main>
</Base>

<style is:global>
  .feed-wrap { max-width: 680px; margin: 0 auto; padding: 0 16px 80px; }

  .search-hdr {
    position: sticky; top: 0; z-index: 50;
    background: rgba(245,245,247,0.82);
    -webkit-backdrop-filter: saturate(180%) blur(14px);
    backdrop-filter: saturate(180%) blur(14px);
    border-bottom: 1px solid rgba(0,0,0,0.06);
  }
  .search-hdr-inner {
    max-width: 680px; margin: 0 auto;
    padding: 12px 16px;
    display: flex; align-items: center; gap: 10px;
  }
  .search-bar {
    flex: 1; min-width: 0;
    display: flex; align-items: center; gap: 8px;
    height: 44px; padding: 0 12px;
    background: var(--card);
    border: 1px solid var(--divider);
    border-radius: 12px;
    transition: border-color 140ms ease, box-shadow 140ms ease;
  }
  .search-bar:focus-within {
    border-color: #ed781f;
    box-shadow: 0 0 0 3px rgba(237,120,31,0.12);
  }
  .search-bar-icon { flex-shrink: 0; color: var(--text-3); }
  .search-input {
    flex: 1; min-width: 0;
    border: none; outline: none; background: transparent;
    font-family: var(--font); font-size: 17px; font-weight: 600;
    color: var(--text-1); letter-spacing: -0.01em;
  }
  .search-input::placeholder { color: var(--text-3); font-weight: 500; }
  .search-clear {
    flex-shrink: 0; display: inline-flex; align-items: center; justify-content: center;
    width: 22px; height: 22px; border-radius: 50%;
    background: var(--divider); color: var(--text-2);
    border: none; cursor: pointer;
    transition: background 120ms ease;
  }
  .search-clear:hover { background: var(--flat); color: #fff; }
  .search-clear[hidden] { display: none; }
  .search-cancel {
    flex-shrink: 0; font-size: 17px; font-weight: 700;
    color: var(--text-2); letter-spacing: -0.01em;
    padding: 4px 2px; white-space: nowrap;
    text-decoration: none;
    transition: color 120ms ease;
  }
  .search-cancel:hover { color: var(--text-1); }

  .search-loading { padding: 40px 0; text-align: center; font-size: 15px; color: var(--text-3); }

  /* 입력 전: 최근 검색어 */
  .search-idle { padding: 22px 2px 0; }
  .idle-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px; }
  .idle-label { font-size: 14px; font-weight: 700; color: var(--text-3); letter-spacing: -0.01em; }
  .recent-clear-all {
    font-size: 14px; font-weight: 700; color: var(--text-3);
    background: none; border: none; cursor: pointer; padding: 4px 2px;
    letter-spacing: -0.01em; transition: color 120ms ease;
  }
  .recent-clear-all:hover { color: var(--down); }
  .recent-list { display: flex; flex-direction: column; gap: 2px; }
  .recent-item { display: flex; align-items: center; gap: 8px; padding: 10px 4px; }
  .recent-go {
    flex: 1; min-width: 0; display: flex; align-items: center; gap: 11px;
    background: none; border: none; cursor: pointer; text-align: left; padding: 0;
  }
  .recent-go:hover .recent-name { opacity: 0.62; }
  .recent-ico { flex-shrink: 0; color: var(--text-3); }
  .recent-name {
    font-size: 17px; font-weight: 700; color: var(--text-1); letter-spacing: -0.02em;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    transition: opacity 120ms ease;
  }
  .recent-date { flex-shrink: 0; font-size: 14px; font-weight: 600; color: var(--text-3); letter-spacing: -0.01em; }
  .recent-del {
    flex-shrink: 0; display: inline-flex; align-items: center; justify-content: center;
    width: 26px; height: 26px; border-radius: 50%; color: var(--text-3);
    background: none; border: none; cursor: pointer;
    transition: background 120ms ease, color 120ms ease;
  }
  .recent-del:hover { background: var(--divider); color: var(--text-1); }

  /* 방송 언급 아이콘 (전파 모양) */
  .bc-ico { flex-shrink: 0; color: #ed781f; margin-left: 5px; }
  .result-name-row { display: flex; align-items: center; gap: 0; margin-bottom: 5px; }
  .result-market {
    display: inline-flex; align-items: center;
    font-size: 12px; font-weight: 800; letter-spacing: 0.01em;
    color: var(--text-3);
    padding: 2px 7px; border-radius: 6px;
    background: var(--divider);
  }

  /* 결과 */
  .result-count { font-size: 14px; font-weight: 700; color: var(--text-3); letter-spacing: -0.01em; padding: 22px 2px 12px; }
  .result-list { display: flex; flex-direction: column; gap: 8px; }
  .result-card {
    display: flex; align-items: center; gap: 12px;
    padding: 16px 14px;
    background: var(--card); box-shadow: var(--shadow-card);
    border-radius: 12px;
    text-decoration: none;
    transition: box-shadow 160ms ease, transform 160ms ease, border-color 160ms ease;
  }
  .result-card:hover {
    box-shadow: var(--shadow-card-hover);
    transform: translateY(-1px);
  }
  .result-info { flex: 1; min-width: 0; }
  .result-name { font-size: 17px; font-weight: 800; color: var(--text-1); letter-spacing: -0.02em; min-width: 0; }
  .result-name mark { background: rgba(237,120,31,0.16); color: #c45e0a; border-radius: 3px; padding: 0 1px; }
  .result-meta { font-size: 15px; font-weight: 600; color: var(--text-3); letter-spacing: -0.01em; display: flex; align-items: center; }
  .result-meta b { font-weight: 800; color: var(--text-2); }
  .result-dot { width: 2.5px; height: 2.5px; border-radius: 50%; background: var(--text-3); opacity: 0.5; margin: 0 8px; }
  .result-arrow { flex-shrink: 0; color: var(--text-3); opacity: 0.55; }

  /* 전체 종목 인덱스 */
  .stock-index { padding: 28px 0 0; position: relative; }
  .stock-index-label { font-size: 14px; font-weight: 700; color: var(--text-3); letter-spacing: -0.01em; margin-bottom: 14px; padding: 0 2px; }
  .stock-section { margin-bottom: 4px; }
  .stock-section-header {
    font-size: 13px; font-weight: 800; color: var(--text-3);
    letter-spacing: 0.02em;
    padding: 10px 2px 6px;
    border-bottom: 0.5px solid var(--divider);
    margin-bottom: 2px;
  }
  .stock-item {
    display: flex; align-items: center;
    width: 100%; padding: 11px 4px;
    font-size: 16px; font-weight: 600; color: var(--text-1); letter-spacing: -0.01em;
    background: none; border: none; cursor: pointer; text-align: left;
    border-bottom: 0.5px solid var(--divider);
    transition: opacity 120ms ease;
  }
  .stock-item:hover { opacity: 0.62; }

  /* 감정 태그 칩 (긍정/중립/주의) — 랭킹 페이지와 동일 색 */
  .stock-sent {
    flex-shrink: 0; margin-left: 7px;
    font-size: 12px; font-weight: 700; letter-spacing: -0.01em;
    border-radius: 6px; padding: 2px 7px;
  }
  .stock-sent--pos { background: var(--up-bg); color: var(--up); }
  .stock-sent--neu { background: #FEF6DC; color: #9A7B0A; box-shadow: inset 0 0 0 1px #9A7B0A; }
  .stock-sent--warn { background: var(--down-bg); color: var(--down); }
  .result-meta .stock-sent { margin-left: 0; margin-right: 8px; }

  /* 2주 흐름 보조 표기 — 일간과 다를 때만. 배지가 아니라 은은한 텍스트 */
  .stock-flowtag {
    flex-shrink: 0; margin-left: 6px;
    display: inline-flex; align-items: center; gap: 3px;
    font-size: 12px; font-weight: 500; color: var(--text-3);
    white-space: nowrap;
  }
  .stock-flowtag::before {
    content: ""; width: 4px; height: 4px; border-radius: 50%;
    background: var(--tone, currentColor); margin-right: 1px;
  }
  .stock-flowtag b { font-weight: 700; color: var(--tone, inherit); }
  .stock-flowtag--pos { --tone: var(--up); }
  .stock-flowtag--neu { --tone: #9A7B0A; }
  .stock-flowtag--warn { --tone: var(--down); }
  .result-meta .stock-flowtag { margin-left: 0; margin-right: 8px; }

  /* 우측 인덱스 바 */
  .index-bar {
    position: fixed; right: 6px; top: 50%; transform: translateY(-50%);
    display: flex; flex-direction: column; align-items: center; gap: 1px;
    z-index: 40;
  }
  .index-bar a {
    font-size: 11px; font-weight: 700; color: #ed781f;
    line-height: 1.4; padding: 1px 4px;
    text-decoration: none;
  }
  .index-bar a:hover { opacity: 0.6; }

  /* 결과 없음 */
  .search-noresult { padding: 72px 24px; text-align: center; display: flex; flex-direction: column; align-items: center; }
  .search-noresult svg { color: var(--text-3); opacity: 0.45; margin-bottom: 18px; }
  .noresult-title { font-size: 17px; font-weight: 800; color: var(--text-2); letter-spacing: -0.02em; margin-bottom: 8px; }
  .noresult-sub { font-size: 15px; font-weight: 500; color: var(--text-3); line-height: 1.6; letter-spacing: -0.01em; max-width: 280px; }
</style>

<script define:vars={{ stockAliasMap }}>
(function () {
  var inputEl  = document.getElementById('search-input');
  var clearEl  = document.getElementById('search-clear');
  var bodyEl   = document.getElementById('search-body');
  var cancelEl = document.getElementById('search-cancel');

  var INDEX = [];

  // 최근 검색어 (브라우저 localStorage에 저장)
  var RECENT_KEY = 'tedpick_recent_searches';
  function loadRecent() {
    try {
      var a = JSON.parse(localStorage.getItem(RECENT_KEY) || '[]');
      return Array.isArray(a) ? a : [];
    } catch (e) { return []; }
  }
  function saveRecent(a) {
    try { localStorage.setItem(RECENT_KEY, JSON.stringify(a)); } catch (e) {}
  }
  function addRecent(name) {
    if (!name) return;
    var a = loadRecent().filter(function (x) { return x.name !== name; });
    a.unshift({ name: name, ts: Date.now() });
    if (a.length > 20) a = a.slice(0, 20);
    saveRecent(a);
  }
  function removeRecent(name) {
    saveRecent(loadRecent().filter(function (x) { return x.name !== name; }));
  }
  function clearRecent() { saveRecent([]); }

  function fmtDate(ts) {
    var d = new Date(ts);
    var day = 86400000;
    var now = new Date();
    var today0 = new Date(now.getFullYear(), now.getMonth(), now.getDate()).getTime();
    var t0 = new Date(d.getFullYear(), d.getMonth(), d.getDate()).getTime();
    var diff = Math.round((today0 - t0) / day);
    if (diff <= 0) return '오늘';
    if (diff === 1) return '어제';
    return (d.getMonth() + 1) + '월 ' + d.getDate() + '일';
  }

  // 방송 언급 표시 아이콘 (전파가 퍼지는 모양)
  var BC_ICON =
    '<svg class="bc-ico" width="15" height="15" viewBox="0 0 24 24" fill="none" aria-label="방송 언급">' +
      '<circle cx="12" cy="12" r="2.3" fill="currentColor"/>' +
      '<path d="M8 8a5.6 5.6 0 0 0 0 8M16 16a5.6 5.6 0 0 0 0-8M5.2 5.2a9.6 9.6 0 0 0 0 13.6M18.8 18.8a9.6 9.6 0 0 0 0-13.6" ' +
        'stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>' +
    '</svg>';

  // 감정 태그 칩 HTML (status가 있을 때만)
  function sentChip(status) {
    var map = { pos: ['pos', '긍정'], neu: ['neu', '중립'], warn: ['warn', '주의'] };
    var m = map[status];
    if (!m) return '';
    return '<span class="stock-sent stock-sent--' + m[0] + '">' + m[1] + '</span>';
  }

  // 2주 흐름 칩 — 일간 감정과 "다를 때만" 노출 (순위 카드·상세 페이지와 동일 규칙)
  var FLOW_TO_SENT = { good: 'pos', neutral: 'neu', watch: 'warn' };
  var FLOW_LABEL = { pos: '긍정', neu: '중립', warn: '주의' };
  function flowChip(status, flowTone) {
    var cls = FLOW_TO_SENT[flowTone];
    if (!cls || !status || cls === status) return '';
    return '<span class="stock-flowtag stock-flowtag--' + cls + '" title="최근 2주 방송 흐름은 오늘과 달라요">' +
      '최근 2주엔 <b>' + FLOW_LABEL[cls] + '</b></span>';
  }

  function esc(s) {
    return s.replace(/[&<>"]/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c];
    });
  }

  function highlight(name, q) {
    if (!q) return esc(name);
    var i = name.toLowerCase().indexOf(q.toLowerCase());
    if (i < 0) return esc(name);
    return esc(name.slice(0, i)) +
      '<mark>' + esc(name.slice(i, i + q.length)) + '</mark>' +
      esc(name.slice(i + q.length));
  }

  function matches(q) {
    var nq = q.trim().toLowerCase();
    if (!nq) return [];
    var scored = [];
    INDEX.forEach(function (s) {
      var targets = [s.name].concat(s.aliases || []);
      var hit = -1;
      for (var i = 0; i < targets.length; i++) {
        var t = targets[i].toLowerCase();
        if (t.indexOf(nq) === 0) { hit = 0; break; }
        if (t.indexOf(nq) > 0 && hit < 0) hit = 1;
      }
      if (hit >= 0) scored.push({ s: s, hit: hit });
    });
    scored.sort(function (a, b) {
      if (a.hit !== b.hit) return a.hit - b.hit;
      return b.s.mentions - a.s.mentions;
    });
    return scored.map(function (x) { return x.s; });
  }

  var CHOSUNG = ['ㄱ','ㄲ','ㄴ','ㄷ','ㄸ','ㄹ','ㅁ','ㅂ','ㅃ','ㅅ','ㅆ','ㅇ','ㅈ','ㅉ','ㅊ','ㅋ','ㅌ','ㅍ','ㅎ'];
  var DISPLAY = ['ㄱ','ㄴ','ㄷ','ㄹ','ㅁ','ㅂ','ㅅ','ㅇ','ㅈ','ㅊ','ㅋ','ㅌ','ㅍ','ㅎ'];

  function getChosung(ch) {
    var code = ch.charCodeAt(0);
    if (code >= 0xAC00 && code <= 0xD7A3) {
      return CHOSUNG[Math.floor((code - 0xAC00) / 28 / 21)];
    }
    if (/[A-Za-z]/.test(ch)) return ch.toUpperCase();
    return '#';
  }

  function normalizeKey(ch) {
    // ㄲ→ㄱ, ㄸ→ㄷ, ㅃ→ㅂ, ㅆ→ㅅ, ㅉ→ㅈ (된소리는 예사소리로 묶기)
    var map = { 'ㄲ':'ㄱ','ㄸ':'ㄷ','ㅃ':'ㅂ','ㅆ':'ㅅ','ㅉ':'ㅈ' };
    return map[ch] || ch;
  }

  function renderIdle() {
    // 최근 검색어
    var recent = loadRecent();
    var recentHtml = '';
    if (recent.length) {
      var items = recent.map(function (r) {
        return '<div class="recent-item">' +
          '<button class="recent-go" data-name="' + esc(r.name) + '">' +
            '<svg class="recent-ico" width="16" height="16" viewBox="0 0 24 24" fill="none">' +
              '<circle cx="12" cy="12" r="8.2" stroke="currentColor" stroke-width="1.8"/>' +
              '<path d="M12 7.6V12l2.8 1.8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>' +
            '</svg>' +
            '<span class="recent-name">' + esc(r.name) + '</span>' +
          '</button>' +
          '<span class="recent-date">' + fmtDate(r.ts) + '</span>' +
          '<button class="recent-del" data-name="' + esc(r.name) + '" aria-label="삭제">' +
            '<svg width="12" height="12" viewBox="0 0 12 12" fill="none">' +
              '<path d="M2 2l8 8M10 2l-8 8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>' +
            '</svg>' +
          '</button>' +
        '</div>';
      }).join('');
      recentHtml =
        '<div class="idle-head">' +
          '<div class="idle-label">최근 검색어</div>' +
          '<button class="recent-clear-all">전체 삭제</button>' +
        '</div>' +
        '<div class="recent-list">' + items + '</div>';
    }

    // 자음별 그룹핑
    var groups = {};
    INDEX.forEach(function (s) {
      var first = s.name.charAt(0);
      var key = normalizeKey(getChosung(first));
      if (!groups[key]) groups[key] = [];
      groups[key].push(s);
    });

    // 정렬 순서: 한글 자음 → 영문 → #
    var keys = Object.keys(groups).sort(function (a, b) {
      var order = function(k) {
        var i = DISPLAY.indexOf(k);
        if (i >= 0) return i;
        if (/[A-Z]/.test(k)) return 100 + k.charCodeAt(0);
        return 999;
      };
      return order(a) - order(b);
    });

    var sections = keys.map(function (key) {
      var items = groups[key].map(function (s) {
        return '<button class="stock-item" data-name="' + esc(s.name) + '">' +
          esc(s.name) + (s.sentiment ? sentChip(s.sentiment) + flowChip(s.sentiment, s.flowTone) : (s.mentioned ? BC_ICON : '')) +
          '</button>';
      }).join('');
      return '<div class="stock-section" id="idx-' + encodeURIComponent(key) + '">' +
        '<div class="stock-section-header">' + key + '</div>' +
        items +
        '</div>';
    }).join('');

    var indexBar = '<div class="index-bar">' +
      keys.map(function (k) {
        return '<a href="#idx-' + encodeURIComponent(k) + '">' + k + '</a>';
      }).join('') +
    '</div>';

    bodyEl.innerHTML =
      '<div class="search-idle">' +
        recentHtml +
        '<div class="stock-index">' +
          '<div class="stock-index-label">전체 종목</div>' +
          sections +
        '</div>' +
      '</div>' +
      indexBar;

    bodyEl.querySelectorAll('.stock-item, .recent-go').forEach(function (b) {
      b.addEventListener('click', function () {
        var nm = b.getAttribute('data-name');
        addRecent(nm);
        location.href = '/stock/' + encodeURIComponent(nm);
      });
    });

    var clearAllBtn = bodyEl.querySelector('.recent-clear-all');
    if (clearAllBtn) clearAllBtn.addEventListener('click', function () {
      clearRecent();
      renderIdle();
    });

    bodyEl.querySelectorAll('.recent-del').forEach(function (b) {
      b.addEventListener('click', function (e) {
        e.stopPropagation();
        removeRecent(b.getAttribute('data-name'));
        renderIdle();
      });
    });
  }

  function renderEmpty(q) {
    bodyEl.innerHTML =
      '<div class="search-noresult">' +
        '<svg width="44" height="44" viewBox="0 0 24 24" fill="none">' +
          '<circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.8"/>' +
          '<path d="m20 20-3.2-3.2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>' +
        '</svg>' +
        '<p class="noresult-title">검색 결과가 없어요</p>' +
        '<p class="noresult-sub">‘' + esc(q.trim()) + '’와 일치하는 코스피·코스닥 종목을 찾지 못했어요.</p>' +
      '</div>';
  }

  function renderResults(list, q) {
    var cards = list.map(function (s) {
      var tag = s.market ? '<span class="result-market">' + esc(s.market) + '</span>' : '';
      var chip = sentChip(s.sentiment) + flowChip(s.sentiment, s.flowTone);
      var meta = s.mentioned
        ? chip + tag + (tag ? '<span class="result-dot"></span>' : '') + '방송 언급 <b>' + s.mentions + '회</b>'
        : (tag || '아직 방송 언급 없음');
      return '<a class="result-card" data-name="' + esc(s.name) + '" href="/stock/' + encodeURIComponent(s.name) + '">' +
        '<div class="result-info">' +
          '<div class="result-name-row"><span class="result-name">' + highlight(s.name, q.trim()) + '</span>' +
            (s.mentioned ? BC_ICON : '') + '</div>' +
          '<div class="result-meta">' + meta + '</div>' +
        '</div>' +
        '<svg class="result-arrow" width="18" height="18" viewBox="0 0 20 20" fill="none">' +
          '<path d="m8 5 5 5-5 5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>' +
        '</svg>' +
      '</a>';
    }).join('');
    bodyEl.innerHTML =
      '<div class="result-count">' + list.length + '개 종목</div>' +
      '<div class="result-list">' + cards + '</div>';

    bodyEl.querySelectorAll('.result-card').forEach(function (a) {
      a.addEventListener('click', function () {
        addRecent(a.getAttribute('data-name'));
      });
    });
  }

  function onInput() {
    var q = inputEl.value;
    clearEl.hidden = !q;
    if (!q.trim()) { renderIdle(); return; }
    var list = matches(q);
    if (list.length === 0) renderEmpty(q);
    else renderResults(list, q);
  }

  inputEl.addEventListener('input', onInput);

  clearEl.addEventListener('click', function () {
    inputEl.value = '';
    onInput();
    inputEl.focus();
  });

  cancelEl.addEventListener('click', function (e) {
    e.preventDefault();
    if (history.length > 1) history.back();
    else location.href = '/';
  });

  var MARKET_LABEL = { KP: '코스피', KQ: '코스닥' };

  // 전체 종목(stocks.json) + 방송 언급·감정·흐름 메타(/api/stock-search-meta)를 함께 불러온다.
  // 메타는 서버에서 KRX 정식 종목만·정확한 단어경계 매칭으로 계산해 준다.
  //  → 유형1(테마키워드 유령항목) 원천 차단, 유형2(개별 방송 언급까지 카운트) 반영.
  var ALIAS_MAP = JSON.parse(stockAliasMap);
  Promise.all([
    fetch('/stocks.json').then(function (r) { return r.json(); }),
    fetch('/api/stock-search-meta').then(function (r) { return r.json(); }).catch(function () { return {}; })
  ])
  .then(function (res) {
    var allStocks = res[0] || [];
    var meta = res[1] || {};

    // 전체 종목을 인덱스로 구성하고 방송 메타를 붙인다. (KRX에 없는 이름은 인덱스에 아예 안 넣음)
    INDEX = allStocks.map(function (s) {
      var m = meta[s.n] || {};
      var cnt = m.m || 0;
      return {
        name: s.n, code: s.c, market: MARKET_LABEL[s.m] || '',
        aliases: ALIAS_MAP[s.n] || [],
        mentions: cnt,
        mentioned: cnt > 0,
        sentiment: m.s,
        flowTone: m.f
      };
    });

    renderIdle();
    inputEl.focus();
  })
  .catch(function () {
    bodyEl.innerHTML = '<div class="search-loading">데이터를 불러오지 못했어요.</div>';
  });
})();
</script>
