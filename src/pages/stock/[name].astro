</style>

<script>
  // 회사 소개 접기/펼치기 — 테드픽 소개 + 공식 기업개요를 한 묶음으로, 버튼 하나로 편다.
  document.querySelectorAll<HTMLElement>('[data-intro]').forEach(intro => {
    const toggle = intro.querySelector<HTMLButtonElement>('[data-intro-toggle]');
    if (!toggle) return;
    const label = toggle.querySelector<HTMLElement>('.desc-toggle-label');
    const preview = intro.querySelector<HTMLElement>('.is-preview .stock-desc');
    const hasExtra = !!intro.querySelector('.is-extra');
    // 접힌 상태에서 미리보기 텍스트가 2줄을 넘치는지 판단.
    const previewOverflows = () => !!preview && preview.scrollHeight - preview.clientHeight > 2;

    const sync = () => {
      // 펼친 상태면 버튼 유지. 접힌 상태면 더 보여줄 게 있을 때만 버튼 노출.
      if (!intro.classList.contains('is-collapsed')) { toggle.hidden = false; return; }
      toggle.hidden = !(hasExtra || previewOverflows());
    };

    toggle.addEventListener('click', () => {
      const collapsed = intro.classList.toggle('is-collapsed');
      toggle.classList.toggle('is-open', !collapsed);
      if (label) label.textContent = collapsed ? '더보기' : '접기';
    });

    sync();
    // 화면 폭이 바뀌면(회전 등) 줄 수가 달라지므로 다시 판단한다.
    let t: number | undefined;
    window.addEventListener('resize', () => {
      window.clearTimeout(t);
      t = window.setTimeout(sync, 150);
    });
  });

  // 탭 전환
  const tabs = document.querySelectorAll<HTMLButtonElement>('.tab');
  const panels = document.querySelectorAll<HTMLElement>('.panel');
  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const target = tab.dataset.tab;
      tabs.forEach(t => t.classList.toggle('is-active', t === tab));
      panels.forEach(p => p.classList.toggle('is-active', p.dataset.panel === target));
    });
  });

  // 지표 설명 모달
  const modal = document.getElementById('metricModal');
  if (modal) {
    const titleEl = modal.querySelector('.mm-title') as HTMLElement;
    const subEl = modal.querySelector('.mm-sub') as HTMLElement;
    const bodyEl = modal.querySelector('.mm-body') as HTMLElement;
    const openModal = (title: string, full: string, body: string) => {
      titleEl.textContent = title;
      subEl.textContent = full;
      subEl.hidden = !full;
      bodyEl.textContent = body;
      modal.hidden = false;
      document.body.style.overflow = 'hidden';
    };
    const closeModal = () => {
      modal.hidden = true;
      document.body.style.overflow = '';
    };
    document.querySelectorAll<HTMLButtonElement>('.metric-info').forEach(btn => {
      btn.addEventListener('click', () => openModal(btn.dataset.mtitle ?? '', btn.dataset.mfull ?? '', btn.dataset.mbody ?? ''));
    });
    modal.querySelectorAll('[data-mm-close]').forEach(el => el.addEventListener('click', closeModal));
    document.addEventListener('keydown', e => { if (e.key === 'Escape' && !modal.hidden) closeModal(); });
  }

  const hdrInner = document.querySelector('.hdr-inner') as HTMLElement;
  const hero = document.querySelector('.stock-hero') as HTMLElement;
  if (hdrInner && hero) {
    const ctx = document.createElement('div');
    ctx.className = 'hdr-ctx';

    const backBtn = document.createElement('button');
    backBtn.className = 'hdr-back-btn';
    backBtn.setAttribute('aria-label', '뒤로');
    backBtn.textContent = '←';
    backBtn.addEventListener('click', () => {
      if (history.length > 1) history.back();
      else location.href = '/';
    });

    const label = document.createElement('span');
    label.className = 'hdr-ctx-label';
    label.textContent = document.querySelector('.stock-title')?.textContent ?? '';

    ctx.appendChild(backBtn);
    ctx.appendChild(label);
    hdrInner.appendChild(ctx);

    const observer = new IntersectionObserver(
      ([entry]) => { hdrInner.classList.toggle('is-scrolled', !entry.isIntersecting); },
      { threshold: 0, rootMargin: '-56px 0px 0px 0px' }
    );
    observer.observe(hero);
  }

  // ===== 이 주가, 왜 이래요? (유료회원 예정 — 지금은 안내 모달만) =====
  // 분석 엔진(src/lib/stockWhy.ts, dartDisclosures.ts, /api/stock-why)은 그대로 보관돼 있고,
  // 유료회원 시스템이 준비되면 버튼을 실제 분석 호출로 연결한다.
  const whyCard = document.querySelector<HTMLElement>('[data-why]');
  const whyModal = document.getElementById('metricModal');
  if (whyCard && whyModal) {
    whyCard.addEventListener('click', e => {
      if (!(e.target as HTMLElement).closest('[data-why-premium]')) return;
      (whyModal.querySelector('.mm-title') as HTMLElement).textContent = '곧 만나요 🔒';
      const sub = whyModal.querySelector('.mm-sub') as HTMLElement;
      sub.textContent = '유료회원 전용 기능이에요';
      sub.hidden = false;
      (whyModal.querySelector('.mm-body') as HTMLElement).textContent =
        '이 종목이 왜 이렇게 움직이는지 공시·뉴스·실적을 모아 정리해주는 기능이에요. 곧 유료회원에게 먼저 선보일 예정이에요. 조금만 기다려 주세요.';
      whyModal.hidden = false;
      document.body.style.overflow = 'hidden';
    });
  }
</script>
