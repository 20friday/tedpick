  .htag--watch { color: var(--warn); border: 1px solid color-mix(in srgb, var(--warn) 35%, transparent); }
  .htag--caution { color: var(--bad); border: 1px solid color-mix(in srgb, var(--bad) 35%, transparent); }

  /* 컨센서스 */
