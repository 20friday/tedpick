  .metric-verdict { font-size: 12px; font-weight: 700; border-radius: 6px; padding: 3px 8px; margin-left: auto; }
  .mv--good { color: var(--good); background: var(--good-bg); }
  .mv--watch { color: var(--warn); background: var(--warn-bg); }
