  .d-card { background: var(--card); box-shadow: var(--shadow-card); border-radius: 16px; padding: 18px; }
  .d-h { font-size: 17px; font-weight: 800; color: var(--text-1); margin-bottom: 14px; letter-spacing: -0.02em; }
  .d-note { font-size: 13px; line-height: 1.6; color: var(--text-3); margin: 12px 0 0; }

  /* 건강 상태 */
  .health--good { background: var(--good-bg); }
  .health--watch { background: var(--warn-bg); }
  .health--caution { background: var(--bad-bg); }
  .health-head { display: flex; align-items: center; gap: 8px; margin-bottom: 12px; }
  .health-emoji { font-size: 22px; }
  .health-title { font-size: 19px; font-weight: 800; color: var(--text-1); letter-spacing: -0.02em; }
