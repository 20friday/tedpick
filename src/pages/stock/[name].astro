  /* 더보기/접기 — 우측 정렬 텍스트 버튼, 탭 여백만 확보 */
  .desc-toggle {
    display: flex;
    width: fit-content;
    margin: 8px 0 0 auto;   /* 오른쪽 정렬 */
    align-items: center;
    gap: 5px;
    min-height: 36px;
    padding: 6px 2px;
    background: none;
    border: none;
    cursor: pointer;
    font-family: inherit;
    font-size: 14px;
    font-weight: 700;
    color: var(--blue);
    letter-spacing: -0.01em;
    transition: opacity 120ms ease;
    -webkit-tap-highlight-color: transparent;
