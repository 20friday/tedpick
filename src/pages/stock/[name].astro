  .desc-toggle[hidden] { display: none; }
  .desc-toggle::after {
    content: '';
    width: 7px; height: 7px;
    margin-top: -3px;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(45deg);
    transition: transform 160ms ease;
