---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { stockInfo } from '../../lib/stockInfo';
import { canonicalStockName } from '../../lib/stockCodes';
import { resolveStockCodes } from '../../lib/resolveStockCode';
import { getStockDetail, type StockDetail } from '../../lib/stockDetail';
import { getCompanyOverview } from '../../lib/companyOverview';
import { BROADCAST_LABEL, snippetFor } from '../../lib/stockRanking';

const rawName = (Astro.params as { name: string }).name;
// "THE E&M"의 & 등 URL 인코딩(%26)이 남아 오면 종목명이 안 맞으니 안전하게 디코딩한다.
let name = rawName;
try { name = decodeURIComponent(rawName); } catch { name = rawName; }
// 옛 이름·약칭으로 저장된 과거 글도 같이 잡히도록 정식명 기준으로 매칭한다.
const canonName = canonicalStockName(name);
const matchesStock = (s: any) => canonicalStockName(s.name) === canonName;

// 1. content collection (과거 리포트)
const allReports = await getCollection('reports');
const contentEntries = allReports
  .filter(r => r.data.stocks?.some(matchesStock))
  .map(r => {
    const stock = r.data.stocks.find(matchesStock)!;
    return { date: r.data.date as string, shows: stock.shows as string[], notes: (stock.notes ?? []) as any[] };
  });

// 2. Supabase (신규 리포트)
const { data: supabaseReports } = await Astro.locals.supabase
  .from('daily_reports')
  .select('date, stocks, sentiment')
  .order('date', { ascending: false });

// 대표 감정: 가장 최근 방송일의 status (pos/neu/warn). date desc 정렬이라 첫 매칭이 최신.
const SENT_LABEL: Record<string, string> = { pos: '긍정', neu: '중립', warn: '주의' };
let sentiment: string | null = null;
for (const r of (supabaseReports ?? []) as any[]) {
  const sent = r.sentiment as Record<string, any> | null;
  if (!sent) continue;
  for (const [nm, s] of Object.entries(sent)) {
    if (s?.status && SENT_LABEL[s.status] && canonicalStockName(nm) === canonName) { sentiment = s.status; break; }
  }
  if (sentiment) break;
}

const supabaseEntries = (supabaseReports ?? [])
  .filter((r: any) => r.stocks?.some(matchesStock))
  .map((r: any) => {
    const stock = r.stocks.find(matchesStock);
    return { date: r.date as string, shows: (stock?.shows ?? []) as string[], notes: (stock?.notes ?? []) as any[] };
  });

// 3. posts(방송별 개별 글) — 오늘의 픽에 안 담겼어도 방송이 태그·본문에서 언급한 기록.
//    최근 글 위주로만 조회(비용 제한). 오늘의 픽이 있는 날짜는 아래 병합에서 그쪽이 우선한다.
const { data: mentionPosts } = await Astro.locals.supabase
  .from('posts')
  .select('date, slug, tags, content')
  .order('date', { ascending: false })
  .limit(240);
const postEntriesByDate = new Map<string, { date: string; shows: string[]; notes: any[] }>();
for (const p of (mentionPosts ?? []) as any[]) {
  const tags: string[] = Array.isArray(p.tags)
    ? p.tags
    : typeof p.tags === 'string' ? p.tags.split(',').map((t: string) => t.trim()) : [];
  const tagged = tags.some((t) => canonicalStockName(t) === canonName);
  const view = snippetFor(p.content ?? '', canonName);
  if (!tagged && !view) continue; // 이 글에선 다루지 않음
  const show = BROADCAST_LABEL[String(p.slug ?? '').slice(11)] ?? String(p.slug ?? '');
  if (!postEntriesByDate.has(p.date)) postEntriesByDate.set(p.date, { date: p.date, shows: [], notes: [] });
  const pe = postEntriesByDate.get(p.date)!;
  if (!pe.shows.includes(show)) pe.shows.push(show);
  if (view) pe.notes.push({ show, view });
}

// 4. 날짜 기준으로 병합. 우선순위: posts(가장 낮음) → 과거 리포트 → Supabase 오늘의 픽(가장 높음).
//    오늘의 픽이 있는 날은 그 정리 코멘트가 이기고, 태그로만 언급된 날은 posts 기록이 남는다.
const dateMap = new Map<string, { date: string; shows: string[]; notes: any[] }>();
for (const e of postEntriesByDate.values()) dateMap.set(e.date, e);
for (const e of contentEntries) dateMap.set(e.date, e);
for (const e of supabaseEntries) dateMap.set(e.date, e);
const entries = [...dateMap.values()].sort((a, b) => b.date.localeCompare(a.date));

// 최근 2주 방송 흐름 요약 — 등록 시 미리 써서 stock_flows에 저장해 둔 걸 그대로 보여준다.
// 아직 요약이 없는 종목은 null → 카드 자체를 숨긴다. (테이블이 없어도 에러는 무시)
let flow: { tone: string; headline: string; body: string; updated_at: string } | null = null;
try {
  const { data: flowRow } = await Astro.locals.supabase
    .from('stock_flows')
    .select('tone, headline, body, updated_at')
    .eq('name', canonName)
    .maybeSingle();
  if (flowRow) flow = flowRow as typeof flow;
} catch { flow = null; }

const info = stockInfo.find(s => canonicalStockName(s.name) === canonName);

// 종목 상세(네이버) — 국내 종목만. 코드 조회 후 목표주가·지표·건강태그 가져오기.
// 비공식 API라 실패하면 detail=null → 섹션 자체를 숨긴다.
let detail: StockDetail | null = null;
let stockCode: string | null = null;

// 회사 소개: 큐레이션 소개(테드픽)와 공식 기업개요(FnGuide)를 각각 준비해 둘 다 보여준다.
const curatedDesc: string = info?.desc ?? '';
let officialDesc = '';

if (!info?.isUS) {
  try {
    const resolved = await resolveStockCodes([canonName]);
    const code = resolved.get(canonName)?.code;
    if (code) {
      stockCode = code;
      const [d, overview] = await Promise.all([
        Promise.race([
          getStockDetail(code, canonName),
          new Promise<null>(resolve => setTimeout(() => resolve(null), 5000)),
        ]),
        getCompanyOverview(code),
      ]);
      detail = d;
      if (overview) officialDesc = overview;
    }
  } catch {
    detail = null;
  }
}

// 둘 다 있을 때만 라벨을 붙여 구분한다.
const showDescLabels = Boolean(curatedDesc && officialDesc);

const days = ['일', '월', '화', '수', '목', '금', '토'];
function formatDate(dateStr: string) {
  const d = new Date(dateStr + 'T00:00:00');
  return `${d.getMonth() + 1}월 ${d.getDate()}일 (${days[d.getDay()]})`;
}

const totalMentions = entries.reduce((acc, e) => acc + e.shows.length, 0);

// 흐름 톤별 이모지 (후킹 문구 앞에 붙임)
const FLOW_EMOJI: Record<string, string> = { good: '😀', watch: '⚠️', neutral: '👀' };

// 2주 흐름 톤 → 감정 클래스 (good=긍정·neutral=중립·watch=주의).
// 히어로 배지: 일간 감정과 2주 흐름이 "다를 때만" 옆에 "최근 2주엔 …"을 덧붙인다(순위 카드와 동일 규칙).
const FLOW_TO_SENT: Record<string, string> = { good: 'pos', neutral: 'neu', watch: 'warn' };
const flowSent: string | null = flow ? (FLOW_TO_SENT[flow.tone] ?? null) : null;
const showFlowChip = Boolean(sentiment && flowSent && flowSent !== sentiment);

// 종목 정보가 있으면 그 탭을 먼저, 없으면 방송 히스토리 탭을 먼저 보여준다.
const defaultTab: 'info' | 'history' = detail ? 'info' : 'history';
---
<Base title={`${canonName} 언급 히스토리`} description={curatedDesc || officialDesc || `${canonName} 방송 언급 모음`} sectionNav={false}>
  <div class="stock-wrap">

    <!-- 헤더 -->
    <div class="stock-hero">
      {(info || sentiment) && (
        <div class="stock-badges">
          {info && <span class="stock-sector">{info.sector}</span>}
          {sentiment && <span class={`stock-sent stock-sent--${sentiment}`}>{SENT_LABEL[sentiment]}</span>}
          {showFlowChip && (
            <span class={`stock-flowtag stock-flowtag--${flowSent}`} title="최근 2주 방송 흐름은 오늘과 달라요">
              최근 2주엔 <b>{SENT_LABEL[flowSent!]}</b>
            </span>
          )}
        </div>
      )}
      <h1 class="stock-title">{canonName}</h1>
      {(curatedDesc || officialDesc) && (
        <div class="company-intro is-collapsed" data-intro>
          {curatedDesc && (
            <div class="intro-block is-preview">
              {showDescLabels && <span class="desc-label desc-label-ted">테드픽 소개</span>}
              <p class="stock-desc">{curatedDesc}</p>
            </div>
          )}
          {officialDesc && (
            <div class={`intro-block ${curatedDesc ? 'is-extra' : 'is-preview'}`}>
              {showDescLabels && <span class="desc-label">공식 기업개요</span>}
              <p class="stock-desc">{officialDesc}</p>
              <p class="desc-source">출처 · FnGuide</p>
            </div>
          )}
          <button type="button" class="desc-toggle" data-intro-toggle hidden>
            <span class="desc-toggle-label">더보기</span>
          </button>
        </div>
      )}
      <div class="stock-stats">
        <div class="stat-item">
          <span class="stat-num">{entries.length}</span>
          <span class="stat-label">일</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
          <span class="stat-num">{totalMentions}</span>
          <span class="stat-label">회 언급</span>
        </div>
      </div>
    </div>

    <!-- ===== 탭 ===== -->
    <div class="tabs" role="tablist">
      <button class={`tab ${defaultTab === 'info' ? 'is-active' : ''}`} data-tab="info" role="tab">종목 정보</button>
      <button class={`tab ${defaultTab === 'history' ? 'is-active' : ''}`} data-tab="history" role="tab">
        방송 언급 {totalMentions > 0 && <span class="tab-count">{totalMentions}</span>}
      </button>
    </div>

    <!-- ===== 종목 정보 탭 ===== -->
    <div class={`panel ${defaultTab === 'info' ? 'is-active' : ''}`} data-panel="info">
    {detail ? (
      <div class="detail">

        <!-- 현재가 -->
        {detail.price && (
          <div class="price-row">
            <span class={`price-now ${detail.price.direction}`}>{detail.price.current}<span class="price-won">원</span></span>
            <span class={`price-chg ${detail.price.direction}`}>
              {detail.price.direction === 'up' ? '▲' : detail.price.direction === 'down' ? '▼' : ''} {detail.price.change} ({detail.price.changePct}%)
            </span>
            <span class="price-status">{detail.price.marketStatus}</span>
          </div>
        )}

        <!-- 52주 범위 (현재가가 1년 중 어디쯤인지) -->
        {detail.week52 && (
          <div class="range52">
            <div class="range52-track">
              <span class="range52-dot" style={`left:${detail.week52.position}%`}></span>
              <span class="range52-flag" style={`left:${detail.week52.position}%`}>현재가</span>
            </div>
            <div class="range52-ends">
              <div class="range52-end">
                <span class="range52-label">52주 최저</span>
                <span class="range52-num low">{detail.week52.low}원</span>
              </div>
              <div class="range52-end range52-end--right">
                <span class="range52-label">52주 최고</span>
                <span class="range52-num high">{detail.week52.high}원</span>
              </div>
            </div>
          </div>
        )}

        <!-- 건강 상태 -->
        {detail.health && (
          <section class={`d-card health health--${detail.health.tone}`}>
            <div class="health-head">
              <span class="health-emoji">{detail.health.tone === 'good' ? '👍' : detail.health.tone === 'caution' ? '⚠️' : '👀'}</span>
              <span class="health-title">{detail.health.headline}</span>
            </div>
            <div class="health-tags">
              {detail.health.tags.map(t => (
                <span class={`htag htag--${t.tone}`}>{t.text}</span>
              ))}
            </div>
            <p class="d-note">회사 실적(매출·영업이익·배당 등)을 기준으로 자동 정리한 상태예요. 방송에서의 평가와는 별개예요.</p>
          </section>
        )}

        <!-- 목표주가 · 투자의견 -->
        {detail.consensus && (
          <section class="d-card">
            <h2 class="d-h">증권사들은 어떻게 볼까요?</h2>
            <div class="consensus-grid">
              <div class="cons-target">
                <span class="cons-label">목표주가</span>
                <span class="cons-target-num">{detail.consensus.targetPrice}<span class="price-won">원</span></span>
                {detail.consensus.upsidePct !== null && (
                  <span class={`cons-upside ${detail.consensus.upsidePct >= 0 ? 'up' : 'down'}`}>
                    현재가보다 {detail.consensus.upsidePct >= 0 ? '+' : ''}{detail.consensus.upsidePct}%
                  </span>
                )}
              </div>
              <div class="cons-opinion">
                <span class="cons-label">투자의견</span>
                <span class="cons-op-label">{detail.consensus.recommLabel}</span>
                <div class="opinion-bar">
                  {['적극매도','매도','중립','매수','적극매수'].map((seg, i) => (
                    <span class={`op-seg ${i+1 === Math.round(detail.consensus.recommMean) ? 'on' : ''}`}>{seg}</span>
                  ))}
                  <span class="op-marker" style={`left:${detail.consensus.recommPct}%`}></span>
                </div>
              </div>
            </div>
            <p class="d-note">최근 3개월간 증권사들이 발표한 전망치 평균이에요. ({detail.consensus.asOf} 기준 · 에프앤가이드 제공)</p>
          </section>
        )}

        <!-- 핵심 지표 + 설명 -->
        {detail.metrics.length > 0 && (
          <section class="d-card">
            <h2 class="d-h">숫자로 보면 이런 회사예요</h2>
            <div class="metrics">
              {detail.metrics.map(m => (
                <div class={`metric ${m.noData ? 'metric--nodata' : ''}`}>
                  <div class="metric-top">
                    <span class="metric-label">{m.label}</span>
                    <button class="metric-info" data-mtitle={m.label} data-mfull={m.fullName} data-mbody={m.explain} aria-label={`${m.label} 설명 보기`} type="button">
                      <svg viewBox="0 0 20 20" width="17" height="17" aria-hidden="true"><circle cx="10" cy="10" r="9" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="10" cy="6" r="1.1" fill="currentColor"/><rect x="9.1" y="8.6" width="1.8" height="6" rx="0.9" fill="currentColor"/></svg>
                    </button>
                    <span class="metric-value">{m.value}</span>
                    {m.verdict && <span class={`metric-verdict mv--${m.tone}`}>{m.verdict}</span>}
                  </div>
                  {m.meaning && <p class={`metric-meaning mm--${m.noData ? 'none' : m.tone}`}>{m.meaning}</p>}
                </div>
              ))}
            </div>
          </section>
        )}

        <!-- 이 주가, 왜 이래요? (유료회원 예정 — 지금은 안내 모달만) -->
        {stockCode && (
          <section class="d-card why-card" data-why>
            <div class="why-cta-head"><span class="why-q">❓</span><span class="why-cta-title">이 주가, 왜 이래요?</span></div>
            <p class="why-cta-desc">방송에 안 나온 종목도, 주가가 왜 이렇게 움직이는지 공시·뉴스·실적으로 정리해드려요.</p>
            <button class="why-btn" data-why-premium type="button">✨ 지금 분석하기</button>
            <p class="why-premium-tag">🔒 곧 유료회원에게 제공될 기능이에요</p>
          </section>
        )}

      </div>
    ) : (
      <div class="empty">종목 정보를 불러오지 못했어요. 잠시 후 다시 들어와 주세요.</div>
    )}
    </div>

    <!-- ===== 방송 언급 히스토리 탭 ===== -->
    <div class={`panel ${defaultTab === 'history' ? 'is-active' : ''}`} data-panel="history">

    <!-- 최근 2주 흐름 요약 (후킹 한 줄 + 짧은 문단) -->
    {flow && (
      <section class={`flow-card flow-card--${flow.tone}`}>
        <div class="flow-head">
          <span class="flow-emoji">{FLOW_EMOJI[flow.tone] ?? '👀'}</span>
          <span class="flow-headline">{flow.headline}</span>
        </div>
        <p class="flow-body">{flow.body}</p>
        <p class="flow-meta">최근 2주 방송 흐름 · {formatDate(flow.updated_at.slice(0, 10))} 업데이트</p>
      </section>
    )}

    {entries.length === 0 ? (
      <div class="empty">아직 언급 기록이 없어요.</div>
    ) : (
      <div class="timeline">
        {entries.map(entry => (
          <div class="timeline-entry">
            <div class="timeline-date">
              <a href={`/report/${entry.date}`} class="timeline-date-link">{formatDate(entry.date)}</a>
            </div>
            <div class="timeline-notes">
              {entry.notes.length > 0 ? entry.notes.map(note => (
                <div class="note-card">
                  <span class="note-show">{note.show}</span>
                  <p class="note-view">{note.view}</p>
                </div>
              )) : (
                <div class="note-card note-card--simple">
                  <div class="note-shows">{entry.shows.map(s => (
                    <span class="note-show">{s}</span>
                  ))}</div>
                  <p class="note-view note-view--muted">이 날 언급됐지만 상세 내용이 없어요.</p>
                </div>
              )}
            </div>
          </div>
        ))}
      </div>
    )}
    </div>

  </div>

  <!-- 지표 설명 모달 -->
  <div class="metric-modal" id="metricModal" hidden>
    <div class="mm-backdrop" data-mm-close></div>
    <div class="mm-box" role="dialog" aria-modal="true" aria-labelledby="mmTitle">
      <div class="mm-head">
        <div class="mm-head-text">
          <h3 class="mm-title" id="mmTitle"></h3>
          <p class="mm-sub"></p>
        </div>
        <button class="mm-close" data-mm-close aria-label="닫기" type="button">✕</button>
      </div>
      <p class="mm-body"></p>
    </div>
  </div>
</Base>

<style>
  .stock-wrap {
    max-width: 680px;
    margin: 0 auto;
    padding: 20px 16px 80px;
  }

  /* 헤더 */
  .stock-hero {
    padding-bottom: 24px;
    border-bottom: 1px solid var(--border);
    margin-bottom: 32px;
  }
  .stock-badges {
    display: flex; align-items: center; gap: 6px; flex-wrap: wrap;
    margin-bottom: 10px;
  }
  .stock-sector {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    color: var(--blue);
    background: color-mix(in srgb, var(--blue) 12%, transparent);
    border-radius: 6px;
    padding: 2px 8px;
  }
  .stock-sent {
    display: inline-block;
    font-size: 11px; font-weight: 700; letter-spacing: -0.01em;
    border-radius: 6px; padding: 2px 8px;
  }
  .stock-sent--pos { background: var(--up-bg); color: var(--up); }
  .stock-sent--neu { background: #FEF6DC; color: #9A7B0A; box-shadow: inset 0 0 0 1px #9A7B0A; }
  .stock-sent--warn { background: var(--down-bg); color: var(--down); }
  /* 2주 흐름이 일간과 다를 때만 노출하는 보조 표기 (배지가 아니라 은은한 텍스트) */
  .stock-flowtag {
    display: inline-flex; align-items: center; gap: 3px;
    font-size: 11px; font-weight: 500; color: var(--text-3);
    white-space: nowrap;
  }
  .stock-flowtag::before {
    content: ""; width: 4px; height: 4px; border-radius: 50%;
    background: var(--tone, currentColor); margin-right: 1px;
  }
  .stock-flowtag b { font-weight: 700; color: var(--tone, inherit); }
  .stock-flowtag--pos { --tone: var(--up); }
  .stock-flowtag--neu { --tone: #9A7B0A; }
  .stock-flowtag--warn { --tone: var(--down); }
  .stock-title {
    font-size: 32px;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--text-1);
    margin-bottom: 10px;
    line-height: 1.2;
  }
  /* 회사 소개 — 테드픽 소개 + 공식 기업개요를 한 묶음으로 접었다 편다 */
  .company-intro {
