  }
  .mm--good { color: #0a7a59; background: var(--good-bg); }
  .mm--watch { color: #b56b00; background: var(--warn-bg); }
  .mm--caution { color: #c2293a; background: var(--bad-bg); }
  /* 데이터 없음 상태 — 값은 흐리게, 이유는 중립 회색 박스 */
  .metric--nodata .metric-value { color: var(--text-3); font-weight: 700; font-size: 16px; }
  .mm--none { color: var(--text-2); background: var(--bg); }

  /* 지표 설명 모달 */
  .metric-modal { position: fixed; inset: 0; z-index: 100; display: flex; align-items: flex-end; justify-content: center; }
  .metric-modal[hidden] { display: none; }
  .mm-backdrop { position: absolute; inset: 0; background: rgba(0,0,0,0.4); }
  .mm-box {
    position: relative; width: 100%; max-width: 480px;
    background: var(--card); border-radius: 20px 20px 0 0;
    padding: 24px 22px calc(28px + env(safe-area-inset-bottom));
    box-shadow: 0 -8px 40px rgba(0,0,0,0.18);
    animation: mm-up .22s ease;
  }
  @media (min-width: 520px) {
    .metric-modal { align-items: center; }
    .mm-box { border-radius: 20px; animation: mm-pop .18s ease; }
  }
  @keyframes mm-up { from { transform: translateY(100%); } to { transform: translateY(0); } }
  @keyframes mm-pop { from { transform: scale(.96); opacity: 0; } to { transform: scale(1); opacity: 1; } }
  .mm-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; margin-bottom: 14px; }
  .mm-title { font-size: 20px; font-weight: 800; color: var(--text-1); letter-spacing: -0.02em; }
  .mm-sub { font-size: 13px; font-weight: 600; color: var(--text-3); margin: 3px 0 0; }
  .mm-sub[hidden] { display: none; }
  .mm-close {
