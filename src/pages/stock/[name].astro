  .why-conclusion b { font-weight: 800; }

  .why-price { font-size: 15px; line-height: 1.7; color: var(--text-2); margin: 0 0 14px; }
  .why-cause { font-size: 15px; line-height: 1.75; color: var(--text-1); margin: 0 0 14px; }
