  /* ===== 탭 ===== */
  .tabs {
    display: flex;
    gap: 4px;
    /* 헤더와 같은 frosted 배경 + 풀블리드로 상단 메뉴 영역에 한 덩어리처럼 붙는다 */
    margin: 0 -16px 24px;
