    width: 32px; height: 32px; border-radius: 50%; color: var(--text-2);
    font-size: 15px; display: flex; align-items: center; justify-content: center;
  }
  .mm-close:hover { background: var(--divider); color: var(--text-1); }
  .mm-body { font-size: 16px; line-height: 1.75; color: var(--text-2); margin: 0; }

  /* 언급 히스토리 헤딩 */
  .section-h { font-size: 17px; font-weight: 800; color: var(--text-1); margin-bottom: 18px; letter-spacing: -0.02em; }

</style>

<!-- why-card는 클라이언트 JS로 내용을 그리므로 스코프드 스타일이 안 먹음 → 전역으로 둔다 -->
<style is:global>
  /* ===== 이 주가, 왜 이래요? ===== */
