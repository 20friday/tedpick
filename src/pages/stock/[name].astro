  .flow-card--good { background: var(--up-bg); border-color: color-mix(in srgb, var(--up) 22%, transparent); }
  .flow-card--watch { background: var(--down-bg); border-color: color-mix(in srgb, var(--down) 22%, transparent); }
  .flow-card--neutral { background: #FEF6DC; border-color: color-mix(in srgb, #9A7B0A 28%, transparent); }
  .flow-head {
