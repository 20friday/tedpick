    color: var(--text-3); font-size: 13px; font-weight: 700; gap: 4px;
  }
  .why-error { font-size: 14px; color: var(--bad); margin: 10px 0 0; }

  /* 분석 후 */
  .why-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px; }
  .why-head-title { display: flex; align-items: center; gap: 7px; font-size: 17px; font-weight: 800; color: var(--text-1); letter-spacing: -0.02em; }

