// 실데이터가 있으면 사용, 없으면 mock
const RANK_DATA = {
  day: DAY_DATA,
  week: initialWeekData ? JSON.parse(initialWeekData) : [],
  month: initialMonthData ? JSON.parse(initialMonthData) : [],
};

// ── 상태 ─────────────────────────────────────────────────────
const state = { period: 'day', open: {} };

// ── 유틸 ─────────────────────────────────────────────────────
function pct(v) {
  const sign = v > 0 ? '+' : '';
  return `${sign}${v.toFixed(1)}%`;
}
function pctClass(v) {
  if (v > 0) return 'up'; if (v < 0) return 'down'; return 'flat';
}

// 최종 순위(뉘앙스 반영)로 화살표(▲▼)를 다시 계산한다.
// 서버 stockRanking.ts의 move 계산 로직과 동일하게 맞춤.
// rankTrail: 오래된→최신 순, 마지막 = 오늘 최종 순위.
function computeMove(rankTrail) {
  if (!Array.isArray(rankTrail) || !rankTrail.length) return { type: 'same', n: 0 };
  const rank = rankTrail[rankTrail.length - 1];
  const prior = rankTrail.slice(0, -1); // 오늘 제외
  const everBefore = prior.some(v => v !== null);
  const prevRank = prior[prior.length - 1]; // 바로 직전 거래일
  if (!everBefore) return { type: 'new', n: 0 };       // 7일 내 첫 등장
  if (prevRank === null) return { type: 're', n: 0 };  // 직전 빠졌다 재진입
  const diff = prevRank - rank;
  return diff > 0 ? { type: 'up', n: diff }
       : diff < 0 ? { type: 'down', n: Math.abs(diff) }
       : { type: 'same', n: 0 };
}

function moveBadge(move) {
  if (move.type === 'up') return `<span class="rank-move rank-move--up">▲${move.n}</span>`;
  if (move.type === 'down') return `<span class="rank-move rank-move--down">▼${move.n}</span>`;
  if (move.type === 'same') return `<span class="rank-move rank-move--same">—</span>`;
  if (move.type === 'new') return `<span class="rank-move rank-move--new">신규진입</span>`;
  if (move.type === 're') return `<span class="rank-move rank-move--re">재진입</span>`;
  return '';
}

// 감정 칩 데스크톱 툴팁(접근성) — 범례와 동일한 의미 설명
const STATUS_TITLE = {
  pos: '긍정 · 좋게 본 분위기',
  neu: '중립 · 담담하게 다룸',
  warn: '주의 · 우려 섞인 분위기',
  mention: '단순 언급 · 평가 없이 이름만 나옴',
};

// 메인 태그 = 그날 방송 뉘앙스(오늘 톤). 2주 흐름과 합치지 않는다.
function statusChip(stock) {
  if (stock.statusReason !== null && (stock.status === 'pos' || stock.status === 'neu' || stock.status === 'warn')) {
    const map = { pos: ['pos','긍정'], neu: ['neu','중립'], warn: ['warn','주의'] };
    const [cls, label] = map[stock.status];
    const fade = stock._sentShown ? '' : ' val-fade';
    stock._sentShown = true;
    return `<span class="rank-status rank-status--${cls}${fade}" title="${STATUS_TITLE[cls]}">${label}</span>`;
  }
  // 뉘앙스 분석 결과가 없는 종목: 로딩이 끝났으면 "단순 언급", 아직이면 스켈레톤
  if (stock.noSentiment) {
    const fade = stock._sentShown ? '' : ' val-fade';
    stock._sentShown = true;
    return `<span class="rank-status rank-status--mention${fade}" title="${STATUS_TITLE.mention}">단순 언급</span>`;
  }
  // 감정 분석 대기 중 → "분석 중" 날것 대신 스켈레톤 칩 (실제 칩과 동일 박스)
  return `<span class="rank-status rank-status--skel" aria-hidden="true">분석중</span>`;
}

// 최근 2주 방송 분위기를 오늘 톤과 별개로 작게 표기.
// 오늘 톤과 "다를 때만" 노출한다 — 같으면 중복이라 조용히 숨긴다.
const FLOW_LABEL = { good: '긍정', neutral: '중립', watch: '주의' };
const FLOW_CLASS = { good: 'pos', neutral: 'neu', watch: 'warn' };
function flowChip(stock) {
  const cls = FLOW_CLASS[stock.flowTone];
  if (!cls) return ''; // 흐름 데이터(stock_flows) 없음
  // 오늘 톤: 감정 있으면 pos/neu/warn, 없으면 'mention'
  const todayCls = stock.noSentiment ? 'mention' : stock.status;
  if (cls === todayCls) return ''; // 오늘 톤과 같으면 표기 생략
  return `<span class="rank-flow rank-flow--${cls}" title="최근 2주 방송 분위기는 오늘과 달라요">최근 2주엔 <b>${FLOW_LABEL[stock.flowTone]}</b></span>`;
}

// 변동률: 로딩이면 스켈레톤 바, 데이터 없으면 "—", 있으면 실제 값(+페이드인)
function changeHtml(stock) {
  if (!stock.priceFetched) {
    return `<span class="rank-change-pct rank-change-pct--skel" aria-hidden="true">+0.0%</span>`;
  }
  const fade = stock._priceShown ? '' : ' val-fade';
  stock._priceShown = true;
  if (stock.priceMatched === false) {
    return `<span class="rank-change-pct rank-change-pct--na${fade}">—</span>`;
  }
  const pcl = pctClass(stock.todayPct);
  return `<span class="rank-change-pct rank-change-pct--${pcl}${fade}">${pct(stock.todayPct)}</span>`;
}

// ── 순위 차트 SVG ─────────────────────────────────────────────
function rankChart(trail) {
  const valid = trail.filter(v => v !== null);
  if (valid.length < 2) return '';

  const W = 320, H = 78, PAD = { t: 18, b: 14, l: 24, r: 24 };
  const cw = W - PAD.l - PAD.r;
  const ch = H - PAD.t - PAD.b;

  // 점 좌표 (null 건너뜀)
  const pts = [];
  trail.forEach((v, i) => {
    if (v === null) return;
    const x = PAD.l + (i / (trail.length - 1)) * cw;
    const y = PAD.t + ((v - 1) / 9) * ch; // 1위=top
    pts.push({ x, y, v, i });
  });

  const linePath = pts.map((p, i) => `${i === 0 ? 'M' : 'L'}${p.x.toFixed(1)},${p.y.toFixed(1)}`).join(' ');
  const areaPath = linePath + ` L${pts[pts.length-1].x.toFixed(1)},${(H - PAD.b).toFixed(1)} L${pts[0].x.toFixed(1)},${(H - PAD.b).toFixed(1)} Z`;

  const first = pts[0], last = pts[pts.length - 1];
  const dots = pts.slice(0, -1).map(p =>
    `<circle cx="${p.x.toFixed(1)}" cy="${p.y.toFixed(1)}" r="2.6" fill="#d4d8df"/>`
  ).join('');

  return `<svg class="rank-chart" viewBox="0 0 ${W} ${H}" preserveAspectRatio="xMidYMid meet">
    <defs>
      <linearGradient id="rcfill" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#ed781f" stop-opacity="0.16"/>
        <stop offset="100%" stop-color="#ed781f" stop-opacity="0"/>
      </linearGradient>
    </defs>
    <path d="${areaPath}" fill="url(#rcfill)"/>
    <path d="${linePath}" fill="none" stroke="#ed781f" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
    ${dots}
    <circle cx="${last.x.toFixed(1)}" cy="${last.y.toFixed(1)}" r="4" fill="#ed781f" stroke="#fff" stroke-width="1.6"/>
    <text x="${first.x.toFixed(1)}" y="${(PAD.t - 4).toFixed(1)}" font-size="14" font-weight="800" fill="var(--text-3)" text-anchor="start">${first.v}위</text>
    <text x="${last.x.toFixed(1)}" y="${(PAD.t - 4).toFixed(1)}" font-size="14" font-weight="800" fill="#ed781f" text-anchor="end">${last.v}위</text>
  </svg>`;
}

// 차트 캡션
function chartCaption(stock) {
  const trail = stock.rankTrail;
  const valid = trail.filter(v => v !== null);
  if (valid.length < 2) return `오늘 처음 TOP 10에 진입했어요.`;
  const first = valid[0], last = valid[valid.length - 1];
  if (first === last) return `최근 7일 동안 <b>${last}위</b>를 유지하고 있어요.`;
  if (last < first) return `최근 일주일 <b>${first}위 → ${last}위</b>로 올라왔어요.`;
  return `최근 일주일 <b>${first}위 → ${last}위</b>로 내려왔어요.`;
}

// ── 상세 패널 HTML ────────────────────────────────────────────
function detailHtml(stock) {
  const priceCol = (label, val) => {
    const cls = pctClass(val);
    return `<div class="price-col">
      <span class="price-col-label">${label}</span>
      <span class="price-val price-val--${cls}">${pct(val)}</span>
    </div>`;
  };

  const factorBlock = (items, type) => {
    if (!items || !items.length) return '';
    const label = type === 'pos' ? '상승 요인' : '주의 요인';
    return `<div class="factor-block factor-block--${type}">
      <div class="factor-head"><span class="factor-dot"></span>${label}</div>
      <ul class="factor-list">${items.map(t => `<li>${t}</li>`).join('')}</ul>
    </div>`;
  };

  let statusReasonTitle, statusReasonHtml;
  if (stock.statusReason !== null) {
    statusReasonTitle = stock.status === 'pos' ? '긍정인 이유는!' : stock.status === 'warn' ? '주의해야 할 이유는!' : '분석 내용은!';
    statusReasonHtml = stock.statusReason ? stock.statusReason : '';
  } else if (stock.noSentiment) {
    statusReasonTitle = '방송 분석 내용';
    statusReasonHtml = `<span style="color:#94a0ad">방송에서 이름은 언급됐지만, 방향성 코멘트는 없었어요.</span>`;
  } else {
    statusReasonTitle = '방송 분석 내용';
    statusReasonHtml = `<span style="color:#94a0ad">뉘앙스 분석 중이에요…</span>`;
  }

  // 감정 기준 시점 라벨: 일간=날짜 / 주간·월간=기간 종합
  let sentLabel = '';
  if (state.period === 'week') sentLabel = '이번 주 종합';
  else if (state.period === 'month') sentLabel = '이번 달 종합';
  else if (stock.sentimentDate) {
    const m = Number(stock.sentimentDate.slice(5, 7));
    const d = Number(stock.sentimentDate.slice(8, 10));
    sentLabel = `${m}월 ${d}일 방송 기준`;
  }

  return `<div class="rank-detail-inner">
    ${statusReasonHtml ? `<div class="detail-sec detail-sec--reason">
      <div class="detail-reason-title">${statusReasonTitle}${sentLabel ? `<span class="detail-reason-date">· ${sentLabel}</span>` : ''}</div>
      <p class="detail-reason-body">${statusReasonHtml}</p>
    </div>` : ''}
    <div class="detail-sec">
      <p class="rank-detail-lead">${stock.reason}</p>
    </div>
    <div class="detail-sec">
      <div class="detail-block-label">최근 7일 순위 변화</div>
      <div class="rank-chart-caption">${chartCaption(stock)}</div>
      ${rankChart(stock.rankTrail)}
    </div>
    <div class="detail-sec">
      <div class="detail-block-label">실제 주가 흐름</div>
      <div class="price-flow">
        ${priceCol('오늘', stock.price.today)}
        ${priceCol('5거래일', stock.price.d5)}
        ${priceCol('1개월', stock.price.m1)}
      </div>
    </div>
    <div class="detail-sec">
      <div class="factor-group">
        ${factorBlock(stock.factorsPos, 'pos')}
        ${factorBlock(stock.factorsWarn, 'warn')}
      </div>
    </div>
    <div class="detail-sec">
      <div class="basis-title">왜 순위에 올랐나요</div>
      <ul class="basis-list">${stock.basis.map(t => `<li>${t}</li>`).join('')}</ul>
      <a class="stock-history-btn" href="/stock/${encodeURIComponent(stock.name)}">방송 언급 히스토리 보기 →</a>
    </div>
  </div>`;
}

// ── 카드 HTML ─────────────────────────────────────────────────
function cardHtml(stock) {
  const isTop3 = stock.rank <= 3;
  const isOpen = !!state.open[stock.name];

  return `<li>
    <div class="rank-card${isTop3 ? ' rank-card--top3' : ''}${isOpen ? ' rank-card--open' : ''}" data-name="${stock.name}">
      <button class="rank-card-btn" aria-expanded="${isOpen}" onclick="toggleCard('${stock.name}')">
        <div class="rank-rail">
          <span class="rank-num">${stock.rank}</span>
          ${moveBadge(stock.move)}
        </div>
        <div class="rank-body">
          <div class="rank-info">
            <div class="rank-name-row">
              <span class="rank-name stock-tag" onclick="event.stopPropagation(); window.open('/stock/' + encodeURIComponent('${stock.name}'), '_blank')">${stock.name}</span>
              ${statusChip(stock)}
              ${flowChip(stock)}
            </div>
            <div class="rank-stat-row">
              ${changeHtml(stock)}
              <span class="rank-sep"></span>
              <span class="rank-hold">${stock.hold}</span>
            </div>
          </div>
          <div class="rank-score">
            <span class="rank-score-num">${stock.score}<span class="rank-score-suffix">점</span></span>
            <span class="rank-score-label">관심 강도</span>
          </div>
          <svg class="rank-chevron" width="18" height="18" viewBox="0 0 18 18" fill="none">
            <path d="M5 7l4 4 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
      </button>
      ${isOpen ? `<div class="rank-detail">${detailHtml(stock)}</div>` : ''}
    </div>
  </li>`;
}

// ── 렌더 ──────────────────────────────────────────────────────
function render() {
  const list = document.getElementById('rankList');
  const empty = document.getElementById('rankEmpty');
  const btn = document.getElementById('showAllBtn');

  const data = RANK_DATA[state.period] || [];

  if (!data.length) {
    list.innerHTML = '';
    list.hidden = true;
    empty.hidden = false;
    btn.hidden = true;
    return;
  }

  list.hidden = false;
  empty.hidden = true;

  try {
    list.innerHTML = data.map(cardHtml).join('');
  } catch(e) {
    list.innerHTML = `<li style="padding:20px;color:#e55;font-size:14px">렌더 오류: ${e instanceof Error ? e.message : String(e)}</li>`;
  }
}

// ── 메타 날짜 ─────────────────────────────────────────────────
function setMetaDate() {
  const el = document.getElementById('metaDate');
  // 순위는 거래일 오후 5시쯤 작성된 일일리포트로 확정됨 → 항상 '장 마감 기준'.
  // 데이터 날짜(오늘 픽 없으면 직전 거래일)를 그대로 표기해 주말·휴일도 자연스럽게 커버.
  const dataDate = RANK_DATA.day[0]?.date;
  const todayKST = new Date(Date.now() + 9 * 60 * 60 * 1000).toISOString().slice(0, 10);
  const base = new Date((dataDate || todayKST) + 'T12:00:00+09:00');
  const days = ['일','월','화','수','목','금','토'];
  const mm = base.getUTCMonth() + 1;
  const dd = base.getUTCDate();
  const dow = days[base.getUTCDay()];
  el.textContent = `${mm}월 ${dd}일 (${dow}) 장 마감 기준`;
}

// ── 이벤트 ────────────────────────────────────────────────────
window.toggleCard = function(name) {
  state.open[name] = !state.open[name];
  render();
};

document.getElementById('periodTabs').addEventListener('click', async e => {
  const tab = e.target.closest('.period-tab');
  if (!tab) return;
  const period = tab.dataset.period;
  if (state.period === period) return;
  state.period = period;
  state.open = {};
  document.querySelectorAll('.period-tab').forEach(t => t.classList.remove('active'));
  tab.classList.add('active');

  // 주간·월간 데이터가 없으면 API로 가져오기
  if (!RANK_DATA[period]?.length && period !== 'day') {
    const list = document.getElementById('rankList');
    list.innerHTML = '<li style="text-align:center;padding:30px;color:var(--text-3);font-size:15px;">불러오는 중…</li>';
    list.hidden = false;
    document.getElementById('rankEmpty').hidden = true;
    try {
      const res = await fetch(`/api/stock-ranking?period=${period}`);
      const data = await res.json();
      RANK_DATA[period] = Array.isArray(data) ? data : [];
    } catch {
      RANK_DATA[period] = [];
    }
  }

  render();

  // 주가 + sentiment 비동기 로드 (렌더 후 백그라운드)
  if (RANK_DATA[period]?.length) {
    loadPrices(RANK_DATA[period]);
    loadSentiment(RANK_DATA[period], period);
  }
});

// ── 초기화 (일간 데이터 API로 로드) ──────────────────────────
(async () => {
  const list = document.getElementById('rankList');
  list.innerHTML = '<li style="text-align:center;padding:40px;color:var(--text-3);font-size:15px;">불러오는 중…</li>';
  list.hidden = false;
  try {
    const res = await fetch('/api/stock-ranking?period=day');
    const data = await res.json();
    RANK_DATA.day = Array.isArray(data) ? data : [];
  } catch {
    RANK_DATA.day = [];
  }
  setMetaDate();
  render();
  if (RANK_DATA.day?.length) {
    loadSentiment(RANK_DATA.day, 'day');
    loadPrices(RANK_DATA.day);
  }
})();

// ── 감정 생성 보장 (초기 렌더 후) ──────────────────────────
// 감정태그·점수·순위는 서버가 종목별로 이미 채워서 보내준다.
// 여기서는 최신 리포트일의 일간 감정이 아직 생성 안 됐을 수 있어
// 한 번 호출해 생성·캐시를 보장하고, 그 결과 단순언급이던 종목이 있으면
// 랭킹을 한 번 다시 받아 갱신한다.
async function loadSentiment(data, period = 'day') {
  if (!data || !data.length || data._sentTriggered) return;
  data._sentTriggered = true;
  const latestDate = data[0]?.date;
  if (!latestDate) return;
  const needGen = data.some(s => s.noSentiment);
  try {
    await fetch(`/api/stock-sentiment?date=${latestDate}&period=day`);
  } catch { /* 무시 */ }
  if (!needGen) return; // 단순언급 종목 없으면 갱신 불필요
  try {
    const res = await fetch(`/api/stock-ranking?period=${period}`);
    const fresh = await res.json();
    if (Array.isArray(fresh) && fresh.length) {
      fresh._sentTriggered = true;
      RANK_DATA[period] = fresh;
      if (state.period === period) { render(); loadPrices(fresh); }
    }
  } catch { /* 무시 */ }
}

// (초기화는 위 IIFE에서 처리)

// ── 주가 비동기 로드 ──────────────────────────────────────────
async function loadPrices(data) {
  if (!data?.length) return;
  // 이미 한 번 조회했으면 스킵 (중복 fetch 방지)
  if (data[0]?.priceFetched) return;

  // 응답 처리: 매칭되면 ready, 누락이면 unavailable. 무조건 priceFetched 확정해
  // 스켈레톤이 영원히 남지 않게 한다.
  const settle = (prices) => {
    const map = (prices && typeof prices === 'object') ? prices : {};
    for (const stock of data) {
      const p = map[stock.name];
      stock.priceFetched = true;
      if (p) {
        stock.priceMatched = true;
        stock.todayPct = p.today;
        stock.price = { today: p.today, d5: p.d5, m1: p.m1 };
      } else {
        stock.priceMatched = false;
      }
    }
    // 현재 보고 있는 탭의 데이터면 다시 렌더
    if (RANK_DATA[state.period] === data) render();
  };

  try {
    const names = data.map(s => s.name).join(',');
    const res = await fetch(`/api/stock-prices?names=${encodeURIComponent(names)}`);
    settle(await res.json());
  } catch {
    // 실패해도 전 종목 unavailable로 확정 (로딩 스켈레톤 잔류 방지)
    settle({});
  }
}

// ── 감정 태그 설명 바텀시트 ──────────────────────────────
(function () {
  const btn = document.getElementById('sentInfoBtn');
  const sheet = document.getElementById('sentSheet');
  const backdrop = document.getElementById('sentSheetBackdrop');
  const closeBtn = document.getElementById('sentSheetClose');
  if (!btn || !sheet || !backdrop) return;

  function onKey(e) { if (e.key === 'Escape') close(); }

  function open() {
    backdrop.hidden = false;
    sheet.hidden = false;
    sheet.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';      // 배경 스크롤 잠금
    requestAnimationFrame(() => {                  // 다음 프레임에 슬라이드업
      backdrop.classList.add('is-open');
      sheet.classList.add('is-open');
    });
    document.addEventListener('keydown', onKey);
    sheet.focus();                                 // 시트로 포커스 이동
  }

  function close() {
    backdrop.classList.remove('is-open');
    sheet.classList.remove('is-open');
    sheet.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    document.removeEventListener('keydown', onKey);
    let done = false;
    const finish = () => {
      if (done) return; done = true;
      sheet.hidden = true; backdrop.hidden = true;
      sheet.removeEventListener('transitionend', finish);
    };
    sheet.addEventListener('transitionend', finish);
    setTimeout(finish, 350);                        // 트랜지션 미발생 폴백
    btn.focus();                                     // ⓘ 버튼으로 포커스 복귀
  }

  btn.addEventListener('click', open);
  backdrop.addEventListener('click', close);
  if (closeBtn) closeBtn.addEventListener('click', close);
})();
</script>
