---
import Base from '../layouts/Base.astro';
---

<Base title="실험실">
  <div class="lab-wrap">
    <div class="lab-header">
      <h1 class="lab-heading">실험실</h1>
      <p class="lab-sub">AI가 방송을 분석해 시도하는 실험적인 기능들이에요.</p>
    </div>

    <div class="lab-prep">
      <div class="lab-prep-icon">🧪</div>
      <div class="lab-prep-title">새로운 실험을 준비하고 있어요</div>
      <p class="lab-prep-body">
        내일 시장 예측은 이제 <b>홈</b>에서 바로 볼 수 있어요.
        실험실에서는 곧 또 다른 분석 실험을 선보일게요.
      </p>
      <a href="/" class="lab-prep-cta">홈에서 시장 예측 보기 →</a>
    </div>
  </div>
</Base>

<style>
  .lab-wrap {
    max-width: 680px;
    margin: 0 auto;
    padding: 20px 16px 80px;
  }
  .lab-header { padding: 16px 0 20px; }
  .lab-heading {
    font-size: 22px;
    font-weight: 900;
    letter-spacing: -0.03em;
    color: var(--text-1);
    margin-bottom: 6px;
  }
  .lab-sub { font-size: 15px; color: var(--text-3); line-height: 1.5; }

  .lab-prep {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 40px 20px;
    text-align: center;
  }
  .lab-prep-icon { font-size: 40px; line-height: 1; margin-bottom: 14px; }
  .lab-prep-title {
    font-size: 19px;
    font-weight: 800;
    color: var(--text-1);
    letter-spacing: -0.02em;
    margin-bottom: 8px;
  }
  .lab-prep-body {
    font-size: 15px;
    color: var(--text-3);
    line-height: 1.65;
    max-width: 300px;
    margin: 0 auto;
  }
  .lab-prep-body b { color: var(--text-2); font-weight: 800; }
  .lab-prep-cta {
    display: inline-block;
    margin-top: 18px;
    font-size: 14px;
    font-weight: 800;
    color: #ed781f;
    text-decoration: none;
  }
</style>
