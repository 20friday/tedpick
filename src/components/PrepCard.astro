---
interface Props {
  latestSlug?: string;
  isMarketHoliday?: boolean;
  todayLabel?: string;
}
const { latestSlug, isMarketHoliday = false, todayLabel = '' } = Astro.props;

const initialTitle = isMarketHoliday ? '오늘은 시장도 잠시 쉬어가요' : '오늘의 PICK은 잠시 쉬어가고 있어요';
const initialDesc  = isMarketHoliday ? '국내 증시 휴장일이라 오늘의 PICK은 쉬어갑니다. 다음 거래일에 주요 방송과 시장 이슈를 정리해서 다시 전해드릴게요.' : '밤사이 주요 이슈를 정리해, 장이 시작되면 다시 시장 흐름을 확인할게요.';
const initialStatus = isMarketHoliday ? '오늘은 쉬는 날' : '오늘 업데이트 예정';
const initialEta   = isMarketHoliday ? '다음 거래일에 다시 확인' : '오전 중 다시 확인';
---

<div class="prep" data-prep-card data-holiday={isMarketHoliday ? 'true' : 'false'} data-band={isMarketHoliday ? 'holiday' : ''} role="status" aria-live="polite">
  <!-- Mascot slot -->
  <div class="prep-cow-slot">
    <div class="prep-cow-wrap" aria-hidden="true">
      <svg viewBox="0 0 140 120" width="112" height="96" style="display:block;overflow:visible">

        <!-- ── Shared body (animated as a group) ── -->
        <g class="cow-body-grp">

          <!-- black patch on top of head -->
          <path d="M28 38 Q34 26 52 30 Q63 36 53 50 Q34 54 28 38 Z" fill="#1f1a14"/>
          <ellipse cx="78" cy="44" rx="9" ry="5" fill="#1f1a14" opacity="0.85"/>

          <!-- ears -->
          <g class="ear ear-l">
            <ellipse cx="28" cy="50" rx="11" ry="6.5" fill="#fffaf2" stroke="#1f1a14" stroke-width="2"
                     transform="rotate(-28 28 50)"/>
            <ellipse cx="28" cy="50" rx="6.5" ry="3.2" fill="#ffd4cc"
                     transform="rotate(-28 28 50)"/>
          </g>
          <g class="ear ear-r">
            <ellipse cx="92" cy="50" rx="11" ry="6.5" fill="#fffaf2" stroke="#1f1a14" stroke-width="2"
                     transform="rotate(28 92 50)"/>
            <ellipse cx="92" cy="50" rx="6.5" ry="3.2" fill="#ffd4cc"
                     transform="rotate(28 92 50)"/>
          </g>

          <!-- horns -->
          <ellipse cx="44" cy="28" rx="4" ry="6" fill="#f5e8d0" stroke="#1f1a14" stroke-width="1.8"/>
          <ellipse cx="76" cy="28" rx="4" ry="6" fill="#f5e8d0" stroke="#1f1a14" stroke-width="1.8"/>

          <!-- head -->
          <ellipse cx="60" cy="62" rx="38" ry="33" fill="#fffaf2" stroke="#1f1a14" stroke-width="2.5"/>

          <!-- top patch above head outline -->
          <path d="M30 42 Q36 32 52 36 Q60 42 50 52 Q34 53 30 42 Z" fill="#1f1a14"/>

          <!-- muzzle -->
          <ellipse cx="60" cy="76" rx="20" ry="14" fill="#ffc9b9" stroke="#1f1a14" stroke-width="2"/>
          <ellipse cx="53" cy="74" rx="1.6" ry="2.2" fill="#1f1a14"/>
          <ellipse cx="67" cy="74" rx="1.6" ry="2.2" fill="#1f1a14"/>
          <path d="M55 84 Q60 87 65 84" stroke="#1f1a14" stroke-width="2" fill="none" stroke-linecap="round"/>

          <!-- cheek blush -->
          <ellipse cx="34" cy="72" rx="4" ry="2.5" fill="#ffb0a0" opacity="0.55"/>
          <ellipse cx="86" cy="72" rx="4" ry="2.5" fill="#ffb0a0" opacity="0.55"/>

          <!-- ── Eyes — sleeping (default) ── -->
          <g class="cow-eyes--sleeping">
            <path d="M42 60 Q48 64 54 60" stroke="#1f1a14" stroke-width="2.4" fill="none" stroke-linecap="round"/>
            <path d="M66 60 Q72 64 78 60" stroke="#1f1a14" stroke-width="2.4" fill="none" stroke-linecap="round"/>
          </g>

          <!-- ── Eyes — watching ── -->
          <g class="cow-eyes--watching eyes-scan">
            <ellipse cx="48" cy="60" rx="3.2" ry="3.8" fill="#1f1a14"/>
            <ellipse cx="72" cy="60" rx="3.2" ry="3.8" fill="#1f1a14"/>
            <circle cx="49.2" cy="58.6" r="1" fill="#fff"/>
            <circle cx="73.2" cy="58.6" r="1" fill="#fff"/>
          </g>

          <!-- ── Eyes — organizing ── -->
          <g class="cow-eyes--organizing">
            <ellipse cx="48" cy="63" rx="2.8" ry="3.4" fill="#1f1a14"/>
            <ellipse cx="72" cy="63" rx="2.8" ry="3.4" fill="#1f1a14"/>
            <circle cx="49" cy="62" r="0.8" fill="#fff"/>
            <circle cx="73" cy="62" r="0.8" fill="#fff"/>
          </g>

        </g><!-- /cow-body-grp -->

        <!-- ── Props — sleeping: zzz ── -->
        <g class="cow-prop--sleeping zzz" font-family="'Pretendard Variable', system-ui, sans-serif">
          <text class="z z1" x="100" y="42" font-size="13" font-weight="800" fill="#94a0ad">z</text>
          <text class="z z2" x="110" y="28" font-size="10" font-weight="800" fill="#94a0ad">z</text>
          <text class="z z3" x="118" y="18" font-size="8"  font-weight="800" fill="#94a0ad">z</text>
        </g>

        <!-- ── Props — watching: chart ── -->
        <g class="cow-prop--watching chart">
          <line x1="102" y1="46" x2="102" y2="72" stroke="#cbd2da" stroke-width="1.2" stroke-linecap="round"/>
          <line x1="102" y1="72" x2="134" y2="72" stroke="#cbd2da" stroke-width="1.2" stroke-linecap="round"/>
          <rect class="bar bar1" x="106" y="62" width="5" height="10" rx="1" fill="#ed781f"/>
          <rect class="bar bar2" x="115" y="56" width="5" height="16" rx="1" fill="#ed781f"/>
          <rect class="bar bar3" x="124" y="50" width="5" height="22" rx="1" fill="#1763d6"/>
        </g>

        <!-- ── Props — organizing: clipboard ── -->
        <g class="cow-prop--organizing clipboard">
          <rect x="100" y="40" width="30" height="36" rx="3" fill="#fff" stroke="#1f1a14" stroke-width="1.8"/>
          <rect x="110" y="36" width="10" height="6" rx="1.5" fill="#cbd2da" stroke="#1f1a14" stroke-width="1.5"/>
          <line class="cb-line cb-l1" x1="105" y1="50" x2="119" y2="50"
                stroke="#cbd2da" stroke-width="1.6" stroke-linecap="round"/>
          <line class="cb-line cb-l2" x1="105" y1="57" x2="125" y2="57"
                stroke="#cbd2da" stroke-width="1.6" stroke-linecap="round"/>
          <line class="cb-line cb-l3" x1="105" y1="64" x2="116" y2="64"
                stroke="#cbd2da" stroke-width="1.6" stroke-linecap="round"/>
          <g class="pencil">
            <line x1="116" y1="64" x2="130" y2="50" stroke="#ed781f" stroke-width="3.2" stroke-linecap="round"/>
            <circle cx="115.5" cy="64.5" r="1.6" fill="#1f1a14"/>
            <circle cx="131"   cy="49"   r="1.4" fill="#ffd4cc"/>
          </g>
        </g>

      </svg>
    </div>
  </div><!-- /prep-cow-slot -->

  <!-- Text area -->
  <div class="prep-text">
    <div class="prep-status">
      <span class="prep-dot" aria-hidden="true"></span>
      {todayLabel && <span class="prep-status-date">{todayLabel}</span>}
      <span class="prep-status-text">{initialStatus}</span>
    </div>
    <h3 class="prep-title">{initialTitle}</h3>
    <p class="prep-desc">{initialDesc}</p>
  </div>

</div>

<style>
  /* ── Card container ── */
  .prep {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 18px 20px;
    margin-bottom: 10px;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 16px;
    align-items: center;
  }

  /* ── Mascot slot ── */
  .prep-cow-slot {
    width: 126px;
    height: 108px;
    background: #fff7ef;
    border-radius: 14px;
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .prep-cow-slot::before {
    content: '';
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 14px;
    height: 1px;
    background: rgba(31, 26, 20, 0.08);
  }

  /* ── Text area ── */
  .prep-text { min-width: 0; }

  /* ── Status chip ── */
  .prep-status {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 5px 10px 5px 9px;
    background: var(--border);
    border-radius: 999px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--text-2);
    margin-bottom: 8px;
  }
  /* 날짜 라벨 — 상태 텍스트 앞에 붙어 '오늘'이 언제인지 보여줌 */
  .prep-status-date {
    font-weight: 800;
    color: var(--text-1);
  }

  /* ── Pulse dot ── */
  .prep-dot {
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--blue);
    animation: prep-pulse 1.8s ease-out infinite;
  }

  /* ── Title ── */
  .prep-title {
    font-size: 17px;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.4;
    color: var(--text-1);
    margin: 0 0 6px;
  }

  /* ── Description ── */
  .prep-desc {
    font-size: 13px;
    font-weight: 400;
    line-height: 1.6;
    color: var(--text-2);
    margin: 0;
  }

  /* ── Footer ── */
  .prep-foot {
    grid-column: 1 / -1;
    margin-top: 12px;
    padding-top: 12px;
    border-top: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }

  /* ── ETA ── */
  .prep-eta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    font-weight: 600;
    color: var(--text-3);
  }
  .prep-eta-clock {
    width: 12px;
    height: 12px;
    opacity: 0.7;
    flex-shrink: 0;
  }

  /* ── CTA ── */
  .prep-cta {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--blue);
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    text-decoration: none;
    transition: color 140ms ease;
  }
  .prep-cta:hover { color: var(--blue-dark); }
  .prep-cta-arrow { font-weight: 800; }

  /* ══════════════════════════════════════
     Animations
  ══════════════════════════════════════ */

  @keyframes prep-pulse {
    0%   { box-shadow: 0 0 0 0   rgba(237, 120, 31, 0.45); }
    70%  { box-shadow: 0 0 0 7px rgba(237, 120, 31, 0); }
    100% { box-shadow: 0 0 0 0   rgba(237, 120, 31, 0); }
  }

  @keyframes prep-pulse-gray {
    0%   { box-shadow: 0 0 0 0   rgba(148, 160, 173, 0.45); }
    70%  { box-shadow: 0 0 0 7px rgba(148, 160, 173, 0); }
    100% { box-shadow: 0 0 0 0   rgba(148, 160, 173, 0); }
  }

  [data-prep-card][data-band="holiday"] .prep-dot {
    background: #94a0ad;
    animation: prep-pulse-gray 1.8s ease-out infinite;
  }

  /* Body animations */
  @keyframes cow-breathe {
    0%, 100% { transform: scale(1); }
    50%      { transform: scale(1.02); }
  }
  @keyframes cow-sleep-bob {
    0%, 100% { transform: translateY(0)   scale(1); }
    50%      { transform: translateY(3px) scale(1.025); }
  }
  @keyframes cow-nod {
    0%, 100% { transform: rotate(-3deg); }
    50%      { transform: rotate(2deg); }
  }

  /* Props animations */
  @keyframes z-float {
    0%   { opacity: 0; transform: translate(0, 6px); }
    30%  { opacity: 1; }
    100% { opacity: 0; transform: translate(4px, -10px); }
  }
  @keyframes eyes-scan {
    0%, 100% { transform: translateX(-2.5px); }
    50%      { transform: translateX(2.5px); }
  }
  @keyframes ear-twitch {
    0%, 85%, 100% { transform: rotate(0deg); }
    90%           { transform: rotate(-10deg); }
  }
  @keyframes bar-pulse {
    0%, 100% { transform: scaleY(0.65); }
    50%      { transform: scaleY(1); }
  }
  @keyframes cb-draw {
    0%, 30%   { stroke-dashoffset: 22; }
    60%, 100% { stroke-dashoffset: 0; }
  }
  @keyframes pencil-wiggle {
    0%, 100% { transform: translate(0, 0)   rotate(0deg); }
    50%      { transform: translate(2px, -2px) rotate(-10deg); }
  }

  /* ══════════════════════════════════════
     Body-group animation per band
  ══════════════════════════════════════ */

  /* Default (dawn / no band yet) → sleep bob */
  .cow-body-grp {
    transform-origin: 60px 90px;
    animation: cow-sleep-bob 3.6s ease-in-out infinite;
  }
  /* premarket + earlymarket → breathe */
  [data-prep-card][data-band="premarket"] .cow-body-grp,
  [data-prep-card][data-band="earlymarket"] .cow-body-grp {
    transform-origin: center;
    animation: cow-breathe 3.4s ease-in-out infinite;
  }
  /* midday + afternoon → nod */
  [data-prep-card][data-band="midday"] .cow-body-grp,
  [data-prep-card][data-band="afternoon"] .cow-body-grp {
    transform-origin: 60px 90px;
    animation: cow-nod 3.2s ease-in-out infinite;
  }

  /* ══════════════════════════════════════
     Eyes visibility per band
     Default: sleeping
  ══════════════════════════════════════ */
  .cow-eyes--sleeping  { display: block; }
  .cow-eyes--watching,
  .cow-eyes--organizing { display: none; }

  [data-prep-card][data-band="premarket"]   .cow-eyes--watching,
  [data-prep-card][data-band="earlymarket"] .cow-eyes--watching  { display: block; }
  [data-prep-card][data-band="premarket"]   .cow-eyes--sleeping,
  [data-prep-card][data-band="premarket"]   .cow-eyes--organizing,
  [data-prep-card][data-band="earlymarket"] .cow-eyes--sleeping,
  [data-prep-card][data-band="earlymarket"] .cow-eyes--organizing { display: none; }

  [data-prep-card][data-band="midday"]     .cow-eyes--organizing,
  [data-prep-card][data-band="afternoon"]  .cow-eyes--organizing { display: block; }
  [data-prep-card][data-band="midday"]     .cow-eyes--sleeping,
  [data-prep-card][data-band="midday"]     .cow-eyes--watching,
  [data-prep-card][data-band="afternoon"]  .cow-eyes--sleeping,
  [data-prep-card][data-band="afternoon"]  .cow-eyes--watching   { display: none; }

  /* ══════════════════════════════════════
     Props visibility per band
     Default: sleeping
  ══════════════════════════════════════ */
  .cow-prop--sleeping  { display: block; }
  .cow-prop--watching,
  .cow-prop--organizing { display: none; }

  [data-prep-card][data-band="premarket"]   .cow-prop--watching,
  [data-prep-card][data-band="earlymarket"] .cow-prop--watching  { display: block; }
  [data-prep-card][data-band="premarket"]   .cow-prop--sleeping,
  [data-prep-card][data-band="premarket"]   .cow-prop--organizing,
  [data-prep-card][data-band="earlymarket"] .cow-prop--sleeping,
  [data-prep-card][data-band="earlymarket"] .cow-prop--organizing { display: none; }

  [data-prep-card][data-band="midday"]     .cow-prop--organizing,
  [data-prep-card][data-band="afternoon"]  .cow-prop--organizing { display: block; }
  [data-prep-card][data-band="midday"]     .cow-prop--sleeping,
  [data-prep-card][data-band="midday"]     .cow-prop--watching,
  [data-prep-card][data-band="afternoon"]  .cow-prop--sleeping,
  [data-prep-card][data-band="afternoon"]  .cow-prop--watching   { display: none; }

  /* ── Prop-specific animations ── */

  /* Zzz */
  .z { animation: z-float 2.8s ease-out infinite; opacity: 0; }
  .z1 { animation-delay: 0s; }
  .z2 { animation-delay: 0.9s; }
  .z3 { animation-delay: 1.8s; }

  /* Eyes scan */
  .eyes-scan { animation: eyes-scan 2.4s ease-in-out infinite; }

  /* Ear twitch (watching bands) */
  [data-prep-card][data-band="premarket"]   .ear-l,
  [data-prep-card][data-band="earlymarket"] .ear-l {
    transform-origin: 28px 50px;
    animation: ear-twitch 4.8s ease-in-out infinite;
  }
  [data-prep-card][data-band="premarket"]   .ear-r,
  [data-prep-card][data-band="earlymarket"] .ear-r {
    transform-origin: 92px 50px;
    animation: ear-twitch 4.8s ease-in-out infinite;
    animation-delay: 2.4s;
  }

  /* Chart bars */
  .bar { transform-origin: center bottom; animation: bar-pulse 1.8s ease-in-out infinite; }
  .bar1 { animation-delay: 0s; }
  .bar2 { animation-delay: 0.3s; }
  .bar3 { animation-delay: 0.6s; }

  /* Clipboard lines */
  .cb-line {
    stroke-dasharray: 22;
    stroke-dashoffset: 22;
    animation: cb-draw 4.5s ease-in-out infinite;
  }
  .cb-l1 { animation-delay: 0s; }
  .cb-l2 { animation-delay: 1.5s; }
  .cb-l3 { animation-delay: 3s; }

  /* Pencil */
  .pencil {
    transform-origin: 116px 64px;
    animation: pencil-wiggle 1.4s ease-in-out infinite;
  }

  /* ── Reduced motion ── */
  @media (prefers-reduced-motion: reduce) {
    .prep-dot,
    .cow-body-grp,
    .eyes-scan,
    .ear-l, .ear-r,
    .bar,
    .cb-line,
    .pencil,
    .z {
      animation: none !important;
    }
    .z     { opacity: 0.6; }
    .cb-line { stroke-dashoffset: 0; }
  }
</style>

<script>
  const BANDS: Record<string, { statusText: string; title: string; desc: string; eta: string }> = {
    dawn: {
      statusText: '오늘 업데이트 예정',
      title:      '오늘의 PICK은 잠시 쉬어가고 있어요',
      desc:       '밤사이 주요 이슈를 정리해, 장이 시작되면 다시 시장 흐름을 확인할게요.',
      eta:        '오전 중 다시 확인',
    },
    premarket: {
      statusText: '개장 전 체크 중',
      title:      '개장 전 이슈를 살펴보고 있어요',
      desc:       '밤사이 글로벌 시장과 주요 뉴스를 확인하며 오늘의 PICK을 준비하고 있어요.',
      eta:        '오전 업데이트 예정',
    },
    earlymarket: {
      statusText: '시장 확인 중',
      title:      '장 초반 흐름을 확인하고 있어요',
      desc:       '시장 방향과 주요 섹터 움직임을 살펴보며 오늘의 PICK에 담을 내용을 정리하고 있어요.',
      eta:        '오후 업데이트 예정',
    },
    midday: {
      statusText: '오전장 정리 중',
      title:      '오전장 흐름을 정리하고 있어요',
      desc:       '오전장 흐름과 주요 종목 움직임을 확인하며 오늘의 핵심 포인트를 추려보고 있어요.',
      eta:        '오후 업데이트 예정',
    },
    afternoon: {
      statusText: '곧 업데이트 예정',
      title:      '오늘의 PICK을 정리하고 있어요',
      desc:       '주요 방송과 시장 이슈를 확인하고, 핵심 종목과 섹터 흐름을 정리하고 있어요.',
      eta:        '오늘 중 발행',
    },
  };

  function currentBand(h: number, m: number): string {
    const t = h + m / 60;
    if (t < 6)    return 'dawn';
    if (t < 9)    return 'premarket';
    if (t < 11.5) return 'earlymarket'; // 11:30
    if (t < 13.5) return 'midday';      // 13:30
    return 'afternoon';
  }

  function apply() {
    const root = document.querySelector<HTMLElement>('[data-prep-card]');
    if (!root) return;
    if (root.dataset.holiday === 'true') return; // 휴장일: 서버 렌더 텍스트 유지
    const now  = new Date();
    const band = currentBand(now.getHours(), now.getMinutes());
    const b    = BANDS[band];
    root.dataset.band = band;
    root.querySelector<HTMLElement>('.prep-status-text')!.textContent = b.statusText;
    root.querySelector<HTMLElement>('.prep-title')!.textContent       = b.title;
    root.querySelector<HTMLElement>('.prep-desc')!.textContent        = b.desc;
    root.querySelector<HTMLElement>('.prep-eta-text')!.textContent    = b.eta;
  }

  apply();
  setInterval(apply, 5 * 60 * 1000);
</script>
